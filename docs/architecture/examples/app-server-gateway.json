{
  "configVersion": 1,
  "defaultInstance": "agents",
  "instances": [
    {
      "id": "legacy",
      "mode": "provider-bridge"
    },
    {
      "id": "agents",
      "mode": "app-server-gateway",
      "host": "isolated",
      "gateway": {
        "defaultEngine": "claude-main",
        "engines": [
          {
            "id": "claude-main",
            "adapter": "claude-code",
            "sdkPath": "/absolute/path/to/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs"
          },
          {
            "id": "copilot-main",
            "adapter": "github-copilot",
            "sdkPath": "/absolute/path/to/node_modules/@github/copilot-sdk/dist/index.js"
          }
        ]
      },
      "desktopApp": "/Applications/ChatGPT.app"
    }
  ]
}
