{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycodex://schemas/knowledge-card/1",
  "title": "MyCodex Knowledge Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "date", "title", "body", "tags", "sources", "status", "createdAt", "updatedAt", "createdBy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^MC-[0-9]{8}-[a-f0-9]{24}$"},
    "revision": {"type": "integer", "minimum": 1},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "body": {"type": "string", "minLength": 1, "maxLength": 50000},
    "tags": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "uri"],
        "properties": {"kind": {"enum": ["thread", "radar", "git", "web"]}, "uri": {"type": "string", "format": "uri", "maxLength": 4096}, "engine": {"type": "string", "maxLength": 128}},
        "allOf": [
          {"if": {"properties": {"kind": {"const": "thread"}}}, "then": {"properties": {"uri": {"pattern": "^mycodex://thread/[a-f0-9-]{36}$"}}}},
          {"if": {"properties": {"kind": {"const": "radar"}}}, "then": {"properties": {"uri": {"pattern": "^mycodex://radar/[a-f0-9]{32}$"}}}},
          {"if": {"properties": {"kind": {"const": "git"}}}, "then": {"properties": {"uri": {"pattern": "^mycodex://git/[a-f0-9]{16}/[a-f0-9]{40}$"}}}},
          {"if": {"properties": {"kind": {"const": "web"}}}, "then": {"properties": {"uri": {"pattern": "^https?://"}}}}
        ]
      }
    },
    "status": {"enum": ["candidate", "reviewed"]},
    "createdAt": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "integer", "minimum": 0},
    "createdBy": {"const": "mycodex"}
  }
}
