+#[cfg(not(target_os = "android"))]
+pub fn paste_text_from_clipboard() -> Result<String, String> {
+    let native_error = match arboard::Clipboard::new()
+        .map_err(|error| error.to_string())
+        .and_then(|mut clipboard| clipboard.get_text().map_err(|error| error.to_string()))
+    {
+        Ok(text) if !text.is_empty() => return Ok(text),
+        Ok(_) => "clipboard text is empty".to_string(),
+        Err(error) => format!("clipboard text unavailable: {error}"),
+    };
+
+    #[cfg(target_os = "linux")]
+    if is_probably_wsl()
+        && let Some(text) = try_read_windows_clipboard_text()
+        && !text.is_empty()
+    {
+        return Ok(text);
+    }
+
+    Err(native_error)
+}
