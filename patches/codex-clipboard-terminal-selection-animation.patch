+#[derive(Debug)]
+pub enum PastedClipboardContent {
+    Image(PathBuf, PastedImageInfo),
+    Text(String),
+}
+
+/// Prefer a real clipboard bitmap/file image, then fall back to clipboard text.
+///
+/// Some terminals report Ctrl+V as the image shortcut even when the clipboard
+/// contains only text. Keeping the decision here makes Ctrl+V useful for both
+/// kinds without treating image encoding or file-system failures as text.
+pub fn paste_clipboard_content() -> Result<PastedClipboardContent, String> {
+    paste_clipboard_content_with(paste_image_to_temp_png, paste_text_from_clipboard)
+}
+
+fn paste_clipboard_content_with(
+    image: impl FnOnce() -> Result<(PathBuf, PastedImageInfo), PasteImageError>,
+    text: impl FnOnce() -> Result<String, String>,
+) -> Result<PastedClipboardContent, String> {
+    match image() {
+        Ok((path, info)) => Ok(PastedClipboardContent::Image(path, info)),
+        Err(
+            image_error @ (PasteImageError::ClipboardUnavailable(_) | PasteImageError::NoImage(_)),
+        ) => match text() {
+            Ok(text) if !text.is_empty() => Ok(PastedClipboardContent::Text(text)),
+            Ok(_) => Err(format!(
+                "image unavailable ({image_error}); text unavailable (clipboard text is empty)"
+            )),
+            Err(text_error) => Err(format!(
+                "image unavailable ({image_error}); text unavailable ({text_error})"
+            )),
+        },
+        Err(error) => Err(format!("image paste failed: {error}")),
+    }
+}
