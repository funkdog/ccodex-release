+    let long_window = positive_window(preset.max_context_window)?;
+    if long_window <= default_window
+        || tier.description.trim().is_empty()
+        || tier.name.trim().is_empty()
+    {
+        return None;
+    }
+
+    Some(ModelContextChoices {
+        default: context_selection(
+            /*service_tier*/ None,
+            default_window,
+            preset.effective_context_window_percent,
+            tier.description.trim().to_string(),
+        ),
+        long: context_selection(
+            Some(LOCAL_CONTEXT_SERVICE_TIER.to_string()),
+            long_window,
+            preset.effective_context_window_percent,
+            tier.name.trim().to_string(),
+        ),
+    })
+}
+
+pub(super) fn default_context_selection(preset: &ModelPreset) -> ModelContextSelection {
+    let model_context_window = positive_window(preset.context_window)
+        .or_else(|| positive_window(preset.max_context_window));
+    let effective_context_window = model_context_window
+        .map(|window| effective_context_window(window, preset.effective_context_window_percent));
+    let label = preset
+        .service_tiers
+        .iter()
+        .find(|tier| tier.id == LOCAL_CONTEXT_SERVICE_TIER)
+        .map(|tier| tier.description.trim())
+        .filter(|label| !label.is_empty())
+        .map(str::to_string)
+        .or_else(|| model_context_window.map(format_tokens_compact))
+        .unwrap_or_else(|| "default".to_string());
+
+    ModelContextSelection {
+        service_tier: None,
+        model_context_window,
+        effective_context_window,
+        label,
+    }
+}
+
+fn context_selection(
+    service_tier: Option<String>,
+    model_context_window: i64,
+    percent: i64,
+    label: String,
+) -> ModelContextSelection {
+    ModelContextSelection {
+        service_tier,
+        model_context_window: Some(model_context_window),
+        effective_context_window: Some(effective_context_window(model_context_window, percent)),
+        label,
+    }
+}
+
+fn positive_window(window: Option<i64>) -> Option<i64> {
+    window.filter(|window| *window > 0)
+}
+
 pub(crate) fn effective_context_window(context_window: i64, percent: i64) -> i64 {
     context_window.saturating_mul(percent.clamp(0, 100)) / 100
 }
