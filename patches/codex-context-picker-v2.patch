+    pub(super) async fn apply_model_context_selection(
+        &mut self,
+        app_server: &mut AppServerSession,
+        model: String,
+        effort: Option<ReasoningEffortConfig>,
+        context: crate::app_event::ModelContextSelection,
+        target: crate::app_event::ModelSelectionTarget,
+    ) {
+        use crate::app_event::ModelSelectionTarget;
+
+        self.chat_widget.set_model(&model);
+        self.config.service_tier = context.service_tier.clone();
+        self.chat_widget
+            .set_service_tier(context.service_tier.clone());
+        self.config.model_context_window = context.model_context_window;
+        self.chat_widget.set_model_context_window_selection(
+            context.model_context_window,
+            context.effective_context_window,
+        );
+
+        let is_ultra =
+            target == ModelSelectionTarget::Global && effort == Some(ReasoningEffortConfig::Ultra);
+        let persisted_effort = match target {
+            ModelSelectionTarget::Global if is_ultra => {
+                self.on_apply_advanced_reasoning(model.as_str(), ReasoningEffortConfig::Ultra)
+            }
+            ModelSelectionTarget::Global => {
+                self.config.model = Some(model.clone());
+                self.on_update_reasoning_effort(effort.clone());
+                effort.clone()
+            }
+            ModelSelectionTarget::PlanOnly => {
+                self.on_update_plan_mode_reasoning_effort(effort.clone());
+                effort.clone()
+            }
+            ModelSelectionTarget::GlobalAndPlan => {
+                self.config.model = Some(model.clone());
+                self.on_update_reasoning_effort(effort.clone());
+                self.on_update_plan_mode_reasoning_effort(effort.clone());
+                effort.clone()
+            }
+        };
+
+        let mut params = if target == ModelSelectionTarget::Global && !is_ultra {
+            self.active_thread_reasoning_setting_update_params(effort.clone())
+        } else {
+            self.active_thread_model_setting_update_params(model.clone())
+        };
+        if let Some(params) = params.as_mut() {
+            params.model = Some(model.clone());
+            params.model_context_window = context.model_context_window;
+            params.service_tier = Some(context.service_tier.clone());
+            if target != ModelSelectionTarget::PlanOnly {
+                params.effort = effort.clone();
+            }
+        }
+        if let Some(params) = params {
+            self.send_thread_settings_update(app_server, params).await;
+        }
+        self.sync_active_thread_service_tier_to_cached_session()
+            .await;
+
+        let mut edits = Vec::new();
+        if target != ModelSelectionTarget::PlanOnly {
+            edits.extend(crate::config_update::build_model_selection_edits(
+                model.as_str(),
+                persisted_effort.as_ref(),
+            ));
+        }
+        if matches!(
+            target,
+            ModelSelectionTarget::PlanOnly | ModelSelectionTarget::GlobalAndPlan
+        ) {
+            let key_path = "plan_mode_reasoning_effort";
+            edits.push(if let Some(effort) = effort.as_ref() {
+                crate::config_update::replace_config_value(
+                    key_path,
+                    serde_json::json!(effort.to_string()),
+                )
+            } else {
+                crate::config_update::clear_config_value(key_path)
+            });
+        }
+        edits.extend(crate::config_update::build_service_tier_selection_edits(
+            context.service_tier.as_deref(),
+        ));
+
+        if let Err(err) =
+            crate::config_update::write_config_batch(app_server.request_handle(), edits).await
+        {
+            let error = crate::config_update::format_config_error(&err);
+            tracing::error!(error = %error, "failed to persist model context selection");
+            self.chat_widget
+                .add_error_message(format!("Failed to save model selection: {error}"));
+            return;
+        }
+
+        let reasoning = Self::reasoning_label(effort.as_ref());
+        self.chat_widget.add_info_message(
+            format!(
+                "Model changed to {model} with {} context and {reasoning} reasoning",
+                context.label
+            ),
+            /*hint*/ None,
+        );
+    }
