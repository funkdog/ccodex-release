+#[tokio::test]
+async fn model_context_selection_sends_one_complete_thread_settings_update() -> Result<()> {
+    let mut app = make_test_app().await;
+    let mut app_server = Box::pin(crate::start_embedded_app_server_for_picker(
+        app.chat_widget.config_ref(),
+    ))
+    .await?;
+    let started = app_server
+        .start_thread(app.chat_widget.config_ref())
+        .await?;
+    let thread_id = started.session.thread_id;
+    app.enqueue_primary_thread_session(started.session, started.turns)
+        .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let context = crate::app_event::ModelContextSelection {
+        service_tier: Some("context-long".to_string()),
+        model_context_window: Some(922_000),
+        effective_context_window: Some(875_900),
+        label: "1.1M".to_string(),
+    };
+
+    let control = Box::pin(app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::ApplyModelContextSelection {
+            model: "gpt-5.4".to_string(),
+            effort: Some(ReasoningEffortConfig::High),
+            context: context.clone(),
+            target: crate::app_event::ModelSelectionTarget::Global,
+        },
+    ))
+    .await?;
+
+    assert!(matches!(control, AppRunControl::Continue));
+    assert_eq!(app.chat_widget.current_model(), "gpt-5.4");
+    assert_eq!(
+        app.chat_widget.current_reasoning_effort(),
+        Some(ReasoningEffortConfig::High)
+    );
+    assert_eq!(
+        app.chat_widget.config_ref().model_context_window,
+        context.model_context_window
+    );
+    assert_eq!(
+        app.chat_widget.configured_service_tier().as_deref(),
+        Some("context-long")
+    );
+
+    let notification = next_thread_settings_updated(&mut app_server, thread_id).await;
+    assert_eq!(notification.thread_settings.model, "gpt-5.4");
+    assert_eq!(
+        notification.thread_settings.model_context_window,
+        Some(922_000)
+    );
+    assert_eq!(
+        notification.thread_settings.service_tier.as_deref(),
+        Some("context-long")
+    );
+    assert_eq!(
+        notification.thread_settings.effort,
+        Some(ReasoningEffortConfig::High)
+    );
+    app_server.shutdown().await?;
+
+    Ok(())
+}
