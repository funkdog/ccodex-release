+//! Context-window usage output for the `/context` slash command.
+
+use super::*;
+
+const CONTEXT_BAR_WIDTH: usize = 20;
+
+fn context_bar(used_tokens: i64, context_window: i64) -> String {
+    let used_ratio = if context_window > 0 {
+        used_tokens.max(0) as f64 / context_window as f64
+    } else {
+        0.0
+    };
+    let filled = (used_ratio * CONTEXT_BAR_WIDTH as f64)
+        .round()
+        .clamp(0.0, CONTEXT_BAR_WIDTH as f64) as usize;
+    format!(
+        "{}{}",
+        "●".repeat(filled),
+        "·".repeat(CONTEXT_BAR_WIDTH - filled)
+    )
+}
+
+fn percentage(numerator: i64, denominator: i64) -> Option<f64> {
+    (denominator > 0).then(|| numerator.max(0) as f64 / denominator as f64 * 100.0)
+}
+
+impl ChatWidget {
+    pub(super) fn add_context_usage_output(&mut self) {
+        let mut lines: Vec<Line<'static>> =
+            vec!["/context".magenta().into(), " Context Usage".bold().into()];
+        let Some(token_info) = self.token_info.as_ref() else {
+            lines.push(
+                format!(
+                    "   {} · usage is available after the first provider response",
+                    self.model_display_name()
+                )
+                .dim()
+                .into(),
+            );
+            self.add_to_history(PlainHistoryCell::new(lines));
+            return;
+        };
+
+        let active = &token_info.last_token_usage;
+        let session = &token_info.total_token_usage;
+        let used_tokens = active.tokens_in_context_window().max(0);
+        let context_window = self.status_line_context_window_size().unwrap_or_default();
+        let context_tier = self
+            .current_service_tier()
+            .filter(|tier| *tier == "context-long")
+            .map(|_| "long")
+            .unwrap_or("default");
+
+        if context_window > 0 {
+            let used_percent = percentage(used_tokens, context_window).unwrap_or_default();
+            lines.push(
+                vec![
+                    "   ".into(),
+                    context_bar(used_tokens, context_window).cyan(),
+                    "  ".into(),
+                    format!(
+                        "{} · {} · {}/{} tokens ({used_percent:.1}%)",
+                        self.model_display_name(),
+                        context_tier,
+                        format_tokens_compact(used_tokens),
+                        format_tokens_compact(context_window)
+                    )
+                    .into(),
+                ]
+                .into(),
+            );
+        } else {
+            lines.push(
+                format!(
+                    "   {} · {} · {} active tokens",
+                    self.model_display_name(),
+                    context_tier,
+                    format_tokens_compact(used_tokens)
+                )
+                .into(),
+            );
+        }
+
+        if active.input_tokens > 0 {
+            lines.push(format!("   Input: {}", format_tokens_compact(active.input_tokens)).into());
+        }
+        if active.cached_input_tokens > 0 {
+            let cache_hit =
+                percentage(active.cached_input_tokens, active.input_tokens).unwrap_or_default();
+            lines.push(
+                format!(
+                    "   Cached input: {} ({cache_hit:.1}% hit)",
+                    format_tokens_compact(active.cached_input_tokens)
+                )
+                .into(),
+            );
+        }
+        if active.output_tokens > 0 {
+            lines
+                .push(format!("   Output: {}", format_tokens_compact(active.output_tokens)).into());
+        }
+        if active.reasoning_output_tokens > 0 {
+            lines.push(
+                format!(
+                    "   Reasoning output: {}",
+                    format_tokens_compact(active.reasoning_output_tokens)
+                )
+                .into(),
+            );
+        }
+        if context_window > 0 {
+            let free_tokens = (context_window - used_tokens).max(0);
+            let free_percent = percentage(free_tokens, context_window).unwrap_or_default();
+            lines.push(
+                format!(
+                    "   Free space: {} ({free_percent:.1}%)",
+                    format_tokens_compact(free_tokens)
+                )
+                .dim()
+                .into(),
+            );
+        }
+        if !session.is_zero() {
+            lines.push(
+                format!(
+                    "   Session total: {}",
+                    format_tokens_compact(session.total_tokens.max(0))
+                )
+                .dim()
+                .into(),
+            );
+        }
+        if self.successful_compaction_count > 0 {
+            lines.push(
+                format!("   Compactions: ×{}", self.successful_compaction_count)
+                    .dim()
+                    .into(),
+            );
+        }
+        if let Some(post_compaction_tokens) = self.last_post_compaction_tokens
+            && context_window > 0
+        {
+            let post_percent =
+                percentage(post_compaction_tokens, context_window).unwrap_or_default();
+            lines.push(
+                format!(
+                    "   Post-compact: {}/{} ({post_percent:.1}%)",
+                    format_tokens_compact(post_compaction_tokens),
+                    format_tokens_compact(context_window)
+                )
+                .dim()
+                .into(),
+            );
+        }
+
+        self.add_to_history(PlainHistoryCell::new(lines));
+    }
+}
