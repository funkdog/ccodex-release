@@ -0,0 +1,84 @@
+//! Watches CodexCopilot's shared selection generation and forwards changes to the TUI.
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use codex_protocol::openai_models::ReasoningEffort;
+use serde::Deserialize;
+use std::path::PathBuf;
+use std::thread;
+use std::time::Duration;
+use tracing::warn;
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct ExternalSelection {
+    pub(crate) schema_version: u32,
+    pub(crate) generation: String,
+    pub(crate) model: String,
+    pub(crate) effort: Option<ReasoningEffort>,
+    pub(crate) context_window: Option<i64>,
+}
+
+pub(crate) fn start_external_model_selection_watcher(app_event_tx: AppEventSender) {
+    let Some(path) = std::env::var_os("CODEX_COPILOT_SELECTION_FILE").map(PathBuf::from) else {
+        return;
+    };
+    let watched_path = path.clone();
+    let spawn_result = thread::Builder::new()
+        .name("codex-copilot-selection-refresh".to_string())
+        .spawn(move || {
+            let mut observed_generation =
+                read_external_selection(&watched_path).map(|value| value.generation);
+            loop {
+                thread::sleep(Duration::from_millis(500));
+                let Some(selection) = read_external_selection(&watched_path) else {
+                    continue;
+                };
+                if observed_generation.as_deref() == Some(selection.generation.as_str()) {
+                    continue;
+                }
+                observed_generation = Some(selection.generation.clone());
+                app_event_tx.send(AppEvent::ApplyExternalModelSelection {
+                    generation: selection.generation,
+                    model: selection.model,
+                    effort: selection.effort,
+                    model_context_window: selection.context_window,
+                });
+            }
+        });
+    if let Err(error) = spawn_result {
+        warn!(selection_path = %path.display(), "failed to start selection watcher: {error}");
+    }
+}
+
+pub(crate) fn read_external_selection(path: &PathBuf) -> Option<ExternalSelection> {
+    let contents = std::fs::read(path).ok()?;
+    let selection: ExternalSelection = serde_json::from_slice(&contents).ok()?;
+    (selection.schema_version == 1
+        && !selection.generation.is_empty()
+        && !selection.model.is_empty())
+    .then_some(selection)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    #[test]
+    fn parses_shared_selection() {
+        let temp = tempfile::NamedTempFile::new().expect("temporary selection");
+        std::fs::write(
+            temp.path(),
+            br#"{"schemaVersion":1,"generation":"next","model":"gpt-test","effort":"high","contextWindow":400000}"#,
+        )
+        .expect("write selection");
+
+        let selection =
+            read_external_selection(&temp.path().to_path_buf()).expect("parse selection");
+        assert_eq!(selection.generation, "next");
+        assert_eq!(selection.model, "gpt-test");
+        assert_eq!(selection.effort, Some(ReasoningEffort::High));
+        assert_eq!(selection.context_window, Some(400_000));
+    }
+}
