@@ -0,0 +1,141 @@
+//! Session-only model context window selection.
+
+use super::*;
+
+const COMPACT_CONTEXT_WINDOW: i64 = 64_000;
+const STANDARD_CONTEXT_WINDOW: i64 = 128_000;
+
+impl ChatWidget {
+    pub(super) fn context_window_selection_item(
+        &self,
+        preset: &ModelPreset,
+    ) -> Option<SelectionItem> {
+        let full_context_window = preset.max_context_window.or(preset.context_window)?;
+        if full_context_window <= 0 {
+            return None;
+        }
+        let current_context_window = self
+            .config
+            .model_context_window
+            .or(preset.context_window)
+            .unwrap_or(full_context_window)
+            .min(full_context_window);
+        let effective_context_window = effective_context_window(
+            current_context_window,
+            preset.effective_context_window_percent,
+        );
+        let preset_for_action = preset.clone();
+        let actions: Vec<SelectionAction> = vec![Box::new(move |tx| {
+            tx.send(AppEvent::OpenContextWindowPopup {
+                model: preset_for_action.clone(),
+            });
+        })];
+
+        Some(SelectionItem {
+            name: "Context window".to_string(),
+            description: Some(format!(
+                "Choose a session-only context size (current: {} raw, {} usable)",
+                format_tokens_compact(current_context_window),
+                format_tokens_compact(effective_context_window),
+            )),
+            actions,
+            dismiss_on_select: true,
+            ..Default::default()
+        })
+    }
+
+    pub(crate) fn open_context_window_popup(&mut self, preset: ModelPreset) {
+        let Some(full_context_window) = preset.max_context_window.or(preset.context_window) else {
+            self.add_info_message(
+                "Context window metadata is unavailable for this model.".to_string(),
+                /*hint*/ None,
+            );
+            return;
+        };
+        if full_context_window <= 0 {
+            self.add_info_message(
+                "Context window metadata is unavailable for this model.".to_string(),
+                /*hint*/ None,
+            );
+            return;
+        }
+
+        let current_context_window = self
+            .config
+            .model_context_window
+            .or(preset.context_window)
+            .unwrap_or(full_context_window)
+            .min(full_context_window);
+        let percent = preset.effective_context_window_percent;
+        let choices = [
+            ("64K", COMPACT_CONTEXT_WINDOW),
+            ("128K", STANDARD_CONTEXT_WINDOW),
+            ("Full", full_context_window),
+        ];
+        let items = choices
+            .into_iter()
+            .map(|(name, model_context_window)| {
+                let model_context_window = model_context_window.min(full_context_window);
+                let effective_context_window =
+                    effective_context_window(model_context_window, percent);
+                let actions: Vec<SelectionAction> = vec![Box::new(move |tx| {
+                    tx.send(AppEvent::UpdateModelContextWindow {
+                        model_context_window,
+                        effective_context_window,
+                    });
+                })];
+                let description = if name == "Full" {
+                    format!(
+                        "{} raw, {} usable at {}%",
+                        format_tokens_compact(model_context_window),
+                        format_tokens_compact(effective_context_window),
+                        percent.clamp(0, 100),
+                    )
+                } else {
+                    format!(
+                        "{} usable at {}%",
+                        format_tokens_compact(effective_context_window),
+                        percent.clamp(0, 100),
+                    )
+                };
+                SelectionItem {
+                    name: name.to_string(),
+                    description: Some(description),
+                    is_current: model_context_window == current_context_window,
+                    actions,
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect();
+
+        self.bottom_pane.show_selection_view(SelectionViewParams {
+            title: Some("Select Context Window".to_string()),
+            subtitle: Some(
+                "Applies to this session only; config.toml remains unchanged.".to_string(),
+            ),
+            footer_hint: Some(standard_popup_hint_line()),
+            items,
+            ..Default::default()
+        });
+    }
+
+    pub(crate) fn set_model_context_window(
+        &mut self,
+        model_context_window: i64,
+        effective_context_window: i64,
+    ) {
+        self.config.model_context_window = Some(model_context_window);
+        let mut token_info = self.token_info.clone().unwrap_or(TokenUsageInfo {
+            total_token_usage: TokenUsage::default(),
+            last_token_usage: TokenUsage::default(),
+            model_context_window: Some(effective_context_window),
+        });
+        token_info.model_context_window = Some(effective_context_window);
+        self.apply_token_info(token_info);
+    }
+}
+
+pub(crate) fn effective_context_window(context_window: i64, percent: i64) -> i64 {
+    context_window.saturating_mul(percent.clamp(0, 100)) / 100
+}
