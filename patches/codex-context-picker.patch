+use super::*;
+use codex_models_manager::model_info::model_info_from_slug;
+use codex_protocol::openai_models::ModelVisibility;
+use pretty_assertions::assert_eq;
+use tempfile::tempdir;
+
+fn model_info(slug: &str) -> codex_protocol::openai_models::ModelInfo {
+    let mut model = model_info_from_slug(slug);
+    model.visibility = ModelVisibility::List;
+    model
+}
+
+#[test]
+fn external_generation_change_replaces_picker_catalog() {
+    let temp = tempdir().expect("temp dir");
+    let catalog_path = temp.path().join("models.json");
+    let generation_path = temp.path().join("catalog-generation.json");
+    let catalog = ModelCatalog::new(vec![model_info("old-model").into()]);
+
+    std::fs::write(
+        &catalog_path,
+        serde_json::to_vec(&ModelsResponse {
+            models: vec![model_info("old-model")],
+        })
+        .expect("serialize initial catalog"),
+    )
+    .expect("write initial catalog");
+    std::fs::write(&generation_path, "generation-1").expect("write initial generation");
+    start_external_refresh(
+        Arc::downgrade(&catalog.models),
+        catalog_path.clone(),
+        generation_path.clone(),
+        Duration::from_millis(10),
+    );
+    thread::sleep(Duration::from_millis(50));
+
+    let expected = (1..=18)
+        .map(|index| format!("new-model-{index}"))
+        .collect::<Vec<_>>();
+    std::fs::write(
+        &catalog_path,
+        serde_json::to_vec(&ModelsResponse {
+            models: expected.iter().map(|slug| model_info(slug)).collect(),
+        })
+        .expect("serialize refreshed catalog"),
+    )
+    .expect("write refreshed catalog");
+    std::fs::write(&generation_path, "generation-2").expect("write refreshed generation");
+
+    let deadline = std::time::Instant::now() + Duration::from_secs(2);
+    loop {
+        let actual = catalog
+            .try_list_models()
+            .expect("catalog read")
+            .into_iter()
+            .map(|model| model.model)
+            .collect::<Vec<_>>();
+        if actual == expected {
+            assert_eq!(actual, expected);
+            break;
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "catalog did not refresh before the deadline: {actual:?}"
+        );
+        thread::sleep(Duration::from_millis(20));
