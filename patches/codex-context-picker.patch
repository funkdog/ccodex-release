+
+/// Removes the next complete UTF-8 prefix from a streaming byte buffer.
+///
+/// Incomplete trailing code points stay buffered until the next read. Invalid leading bytes are
+/// emitted one at a time so the stream keeps making progress and downstream lossy rendering can
+/// represent genuinely invalid command output.
+pub(crate) fn split_utf8_output_prefix(buffer: &mut Vec<u8>, max_bytes: usize) -> Option<Vec<u8>> {
+    if buffer.is_empty() || max_bytes == 0 {
+        return None;
+    }
+
+    let candidate_len = buffer.len().min(max_bytes);
+    let split = match std::str::from_utf8(&buffer[..candidate_len]) {
+        Ok(_) => candidate_len,
+        Err(err) if err.valid_up_to() > 0 => err.valid_up_to(),
+        Err(err) if err.error_len().is_some() => 1,
+        Err(_) => {
+            // The byte cap may itself bisect the first scalar. Extend by at most the remaining
+            // three UTF-8 bytes, but only far enough to emit that one complete scalar.
+            let extended_limit = buffer.len().min(max_bytes.saturating_add(3));
+            let Some(extended_len) = (candidate_len + 1..=extended_limit)
+                .find(|&len| std::str::from_utf8(&buffer[..len]).is_ok())
+            else {
+                return None;
+            };
+            extended_len
+        }
+    };
+
+    Some(buffer.drain(..split).collect())
+}
