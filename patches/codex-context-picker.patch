index 69c9ded..d558984 100644
--- a/codex-rs/tui/src/model_catalog.rs
+++ b/codex-rs/tui/src/model_catalog.rs
@@ -1,17 +1,103 @@
 use codex_protocol::openai_models::ModelPreset;
+use codex_protocol::openai_models::ModelsResponse;
 use std::convert::Infallible;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::RwLock;
+use std::sync::Weak;
+use std::thread;
+use std::time::Duration;
+use tracing::warn;
 
 #[derive(Debug, Clone)]
 pub(crate) struct ModelCatalog {
-    models: Vec<ModelPreset>,
+    models: Arc<RwLock<Vec<ModelPreset>>>,
 }
 
 impl ModelCatalog {
     pub(crate) fn new(models: Vec<ModelPreset>) -> Self {
+        let models = Arc::new(RwLock::new(models));
+        if let Some(catalog_path) =
+            std::env::var_os("CODEX_COPILOT_CATALOG_FILE").map(PathBuf::from)
+        {
+            let generation_path = catalog_path.with_file_name("catalog-generation.json");
+            start_external_refresh(
+                Arc::downgrade(&models),
+                catalog_path,
+                generation_path,
+                Duration::from_secs(2),
+            );
+        }
         Self { models }
     }
 
     pub(crate) fn try_list_models(&self) -> Result<Vec<ModelPreset>, Infallible> {
-        Ok(self.models.clone())
+        Ok(self
+            .models
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone())
     }
 }
+
+fn start_external_refresh(
+    models: Weak<RwLock<Vec<ModelPreset>>>,
+    catalog_path: PathBuf,
+    generation_path: PathBuf,
+    interval: Duration,
+) {
+    let spawn_result = thread::Builder::new()
+        .name("codex-model-catalog-refresh".to_string())
+        .spawn(move || {
+            let mut observed_generation = std::fs::read_to_string(&generation_path).ok();
+            loop {
+                thread::sleep(interval);
+                let Some(models) = models.upgrade() else {
+                    return;
+                };
+                let Ok(generation) = std::fs::read_to_string(&generation_path) else {
+                    continue;
+                };
+                if observed_generation.as_deref() == Some(generation.as_str()) {
+                    continue;
+                }
+                let refreshed = std::fs::read(&catalog_path)
+                    .map_err(|error| error.to_string())
+                    .and_then(|contents| {
+                        serde_json::from_slice::<ModelsResponse>(&contents)
+                            .map_err(|error| error.to_string())
+                    })
+                    .map(|response| {
+                        let mut presets = response
+                            .models
+                            .into_iter()
+                            .map(ModelPreset::from)
+                            .collect::<Vec<_>>();
+                        ModelPreset::mark_default_by_picker_visibility(&mut presets);
+                        presets
+                    });
+                match refreshed {
+                    Ok(presets) => {
+                        *models
+                            .write()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner) = presets;
+                        observed_generation = Some(generation);
+                    }
+                    Err(error) => {
+                        warn!(
+                            catalog_path = %catalog_path.display(),
+                            generation_path = %generation_path.display(),
+                            "failed to refresh external model catalog: {error}"
+                        );
+                    }
+                }
+            }
+        });
+    if let Err(error) = spawn_result {
+        warn!("failed to start external model catalog refresh: {error}");
+    }
+}
+
