+/// Keep stdio JSON byte-safe for clients that decode arbitrary pipe chunks as UTF-8.
+///
+/// JSON permits non-ASCII scalar values to be represented as `\uXXXX` escapes. Emitting only
+/// ASCII means every possible byte split remains valid UTF-8, including splits made by desktop
+/// process-pipe readers before they have reconstructed a complete JSON line.
+fn escape_non_ascii_json(json: &str) -> Cow<'_, str> {
+    if json.is_ascii() {
+        return Cow::Borrowed(json);
+    }
+
+    let mut escaped = String::with_capacity(json.len());
+    for ch in json.chars() {
+        if ch.is_ascii() {
+            escaped.push(ch);
+            continue;
+        }
+
+        let mut code_units = [0_u16; 2];
+        for code_unit in ch.encode_utf16(&mut code_units) {
+            write!(&mut escaped, "\\u{code_unit:04x}")
+                .expect("writing a JSON escape to String cannot fail");
+        }
+    }
+    Cow::Owned(escaped)
+}
