diff --git a/codex-rs/app-server-transport/src/transport/stdio_tests.rs b/codex-rs/app-server-transport/src/transport/stdio_tests.rs
new file mode 100644
index 0000000..c7d5776
--- /dev/null
+++ b/codex-rs/app-server-transport/src/transport/stdio_tests.rs
@@ -0,0 +1,31 @@
+use super::escape_non_ascii_json;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn escaped_stdio_json_round_trips_unicode_at_every_byte_boundary() {
+    let value = serde_json::json!({
+        "message": "当前线程没有乱码🙂",
+        "nested": ["中文", "café", "🚀"],
+    });
+    let json = serde_json::to_string(&value).expect("serialize JSON");
+    let escaped = escape_non_ascii_json(&json);
+
+    assert!(escaped.is_ascii());
+    assert_eq!(
+        serde_json::from_str::<serde_json::Value>(escaped.as_ref()).expect("parse escaped JSON"),
+        value,
+    );
+
+    let bytes = escaped.as_bytes();
+    for split in 0..=bytes.len() {
+        std::str::from_utf8(&bytes[..split]).expect("prefix should be valid UTF-8");
+        std::str::from_utf8(&bytes[split..]).expect("suffix should be valid UTF-8");
+    }
+}
+
+#[test]
+fn ascii_stdio_json_is_borrowed_unchanged() {
+    let json = r#"{"message":"ascii only"}"#;
+
+    assert_eq!(escape_non_ascii_json(json).as_ref(), json);
+}
