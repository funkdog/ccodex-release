+#[test]
+fn utf8_output_prefix_round_trips_every_valid_split() {
+    let expected = "我再确认当前线程日志🙂";
+    let bytes = expected.as_bytes();
+
+    for split in 0..=bytes.len() {
+        let mut pending = bytes[..split].to_vec();
+        let mut emitted = Vec::new();
+        while let Some(chunk) = split_utf8_output_prefix(&mut pending, READ_CHUNK_SIZE) {
+            std::str::from_utf8(&chunk).expect("emitted prefix should be valid UTF-8");
+            emitted.extend(chunk);
+        }
+
+        pending.extend_from_slice(&bytes[split..]);
+        while let Some(chunk) = split_utf8_output_prefix(&mut pending, READ_CHUNK_SIZE) {
+            std::str::from_utf8(&chunk).expect("emitted suffix should be valid UTF-8");
+            emitted.extend(chunk);
+        }
+
+        assert!(pending.is_empty(), "split {split} left pending bytes");
+        assert_eq!(emitted, bytes, "split {split} changed output");
+    }
+}
