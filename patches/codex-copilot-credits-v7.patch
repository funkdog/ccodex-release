diff --git a/codex-rs/tui/src/chatwidget/copilot_status_tests.rs b/codex-rs/tui/src/chatwidget/copilot_status_tests.rs
index 825b9fa..f05aba6 100644
--- a/codex-rs/tui/src/chatwidget/copilot_status_tests.rs
+++ b/codex-rs/tui/src/chatwidget/copilot_status_tests.rs
@@ -2,6 +2,100 @@ use super::*;
 use pretty_assertions::assert_eq;
 use serde_json::json;
 
+fn credit_projection() -> serde_json::Value {
+    let now = chrono::Utc::now();
+    json!({
+        "schemaVersion": 1, "accountGeneration": "one", "status": "available",
+        "statusText": "2,612 / 1,000,000 AI credits · 0.3% used",
+        "progress": 0.002612,
+        "checkedAt": now.to_rfc3339(),
+        "expiresAt": (now + chrono::Duration::minutes(15)).to_rfc3339(),
+        "staleAt": (now + chrono::Duration::minutes(2)).to_rfc3339(),
+        "staleSuffix": " (Last known, not live)",
+        "unavailableText": "AI credits unavailable",
+        "color": { "ansi": 32 }, "staleColor": { "ansi": 90 },
+        "frameMs": 80, "transitionMs": 480
+    })
+}
+
+#[test]
+fn credits_render_the_shared_projection_instead_of_recalculating_request_or_token_usage() {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::write(
+        root.path().join("account-generation.json"),
+        json!({
+            "generation": "one", "login": "test-user", "credits": credit_projection()
+        })
+        .to_string(),
+    )
+    .unwrap();
+    let mut status = CopilotStatus::default();
+    status.refresh(root.path(), None, Instant::now());
+    assert_eq!(
+        (status.credits_text(), status.credits_color()),
+        (
+            Some("○ 2,612 / 1,000,000 AI credits · 0.3% used".to_string()),
+            Some(ratatui::style::Color::Green)
+        )
+    );
+}
+
+#[test]
+fn credits_clear_another_account_projection_and_mark_expired_data_unavailable() {
+    let root = tempfile::tempdir().unwrap();
+    let mut status = CopilotStatus::default();
+    let now = Instant::now();
+    for (index, changed) in ["accountGeneration", "expiresAt", "checkedAt"]
+        .into_iter()
+        .enumerate()
+    {
+        let mut projection = credit_projection();
+        projection[changed] = json!(match changed {
+            "accountGeneration" => "other".to_string(),
+            "expiresAt" => (chrono::Utc::now() - chrono::Duration::seconds(1)).to_rfc3339(),
+            "checkedAt" => (chrono::Utc::now() + chrono::Duration::minutes(1)).to_rfc3339(),
+            _ => unreachable!(),
+        });
+        std::fs::write(
+            root.path().join("account-generation.json"),
+            json!({
+                "generation": "one", "credits": projection
+            })
+            .to_string(),
+        )
+        .unwrap();
+        status.refresh(root.path(), None, now + REFRESH_INTERVAL * index as u32);
+        assert_eq!(
+            status.credits_text().as_deref(),
+            Some("AI credits unavailable")
+        );
+    }
+}
+
+#[test]
+fn credits_expire_using_projected_timestamps_and_share_the_stale_caption_and_color() {
+    let root = tempfile::tempdir().unwrap();
+    let mut projection = credit_projection();
+    projection["staleAt"] = json!((chrono::Utc::now() - chrono::Duration::seconds(1)).to_rfc3339());
+    std::fs::write(
+        root.path().join("account-generation.json"),
+        json!({
+            "generation": "one", "credits": projection
+        })
+        .to_string(),
+    )
+    .unwrap();
+    let mut status = CopilotStatus::default();
+    status.refresh(root.path(), None, Instant::now());
+    assert_eq!(
+        (status.credits_text(), status.credits_color()),
+        (
+            Some("○ 2,612 / 1,000,000 AI credits · 0.3% used (Last known, not live)".to_string()),
+            Some(ratatui::style::Color::DarkGray)
+        )
+    );
+}
