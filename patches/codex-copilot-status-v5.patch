@@ -0,0 +1,110 @@
+use super::*;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+
+#[test]
+fn status_never_uses_another_thread_or_account_request_as_proof() {
+    let root = tempfile::tempdir().unwrap();
+    let thread = ThreadId::new();
+    let other = ThreadId::new();
+    let statuses = root.path().join("request-status");
+    std::fs::create_dir(&statuses).unwrap();
+    std::fs::write(
+        root.path().join("account-generation.json"),
+        r#"{"generation":"one","login":"test-user"}"#,
+    )
+    .unwrap();
+    let mut request = json!({
+        "schemaVersion":1, "threadId":other.to_string(), "accountGeneration":"one",
+        "requestedModel":"gpt-test", "upstreamModel":"gpt-test", "serializedEffort":"high",
+        "contextTier":"default", "status":"complete", "httpStatus":200
+    });
+    let file = statuses.join(format!("{thread}.json"));
+    std::fs::write(&file, request.to_string()).unwrap();
+    let now = Instant::now();
+    let mut status = CopilotStatus::default();
+    status.refresh(root.path(), Some(thread), now);
+    assert_eq!(status.account_text().as_deref(), Some("GitHub @test-user"));
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("high"), "default")
+            .as_deref(),
+        Some("Pending first request")
+    );
+
+    request["threadId"] = thread.to_string().into();
+    std::fs::write(&file, request.to_string()).unwrap();
+    status.refresh(root.path(), Some(thread), now + REFRESH_INTERVAL);
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("high"), "default")
+            .as_deref(),
+        Some("Request verified")
+    );
+    assert_eq!(
+        status
+            .request_text("other-model", Some("high"), "default")
+            .as_deref(),
+        Some("Pending next request")
+    );
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("max"), "default")
+            .as_deref(),
+        Some("Pending next request")
+    );
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("high"), "long_context")
+            .as_deref(),
+        Some("Pending next request")
+    );
+
+    request["strippedParameters"] = json!(["reasoning"]);
+    std::fs::write(&file, request.to_string()).unwrap();
+    status.refresh(root.path(), Some(thread), now + REFRESH_INTERVAL * 2);
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("high"), "default")
+            .as_deref(),
+        Some("Request completed (unverified)")
+    );
+    std::fs::write(
+        root.path().join("account-generation.json"),
+        r#"{"generation":"two","login":"other-user"}"#,
+    )
+    .unwrap();
+    status.refresh(root.path(), Some(thread), now + REFRESH_INTERVAL * 3);
+    assert_eq!(
+        status
+            .request_text("gpt-test", Some("high"), "default")
+            .as_deref(),
+        Some("Pending next request")
+    );
+}
+
+#[test]
+fn missing_malformed_and_oversized_status_records_are_omitted() {
+    let root = tempfile::tempdir().unwrap();
+    let mut status = CopilotStatus::default();
+    let now = Instant::now();
+    status.refresh(root.path(), None, now);
+    assert_eq!(status.account_text(), None);
+    assert_eq!(status.request_text("gpt-test", None, "default"), None);
+    let file = root.path().join("account-generation.json");
+    for (index, bytes) in [
+        b"{broken".to_vec(),
+        vec![b' '; MAX_STATUS_BYTES as usize + 1],
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        std::fs::write(&file, bytes).unwrap();
+        status.refresh(
+            root.path(),
+            None,
+            now + REFRESH_INTERVAL * (index as u32 + 1),
+        );
+        assert_eq!(status.account_text(), None);
+    }
+}
