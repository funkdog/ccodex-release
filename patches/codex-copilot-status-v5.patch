index 0000000..e659d65
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/copilot_status.rs
@@ -0,0 +1,155 @@
+//! Poll small, credential-free bridge records without confusing concurrent threads or accounts.
+
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+use std::time::Duration;
+use std::time::Instant;
+
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+
+use super::ChatWidget;
+
+const REFRESH_INTERVAL: Duration = Duration::from_millis(500);
+const MAX_STATUS_BYTES: u64 = 64 * 1024;
+
+#[derive(Debug, Default)]
+pub(super) struct CopilotStatus {
+    account: Option<Account>,
+    request: Option<Request>,
+    thread: Option<ThreadId>,
+    checked_at: Option<Instant>,
+}
+
+#[derive(Debug, Deserialize, PartialEq)]
+struct Account {
+    generation: String,
+    login: Option<String>,
+}
+
+#[derive(Debug, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+struct Request {
+    schema_version: u32,
+    thread_id: String,
+    account_generation: Option<String>,
+    requested_model: Option<String>,
+    upstream_model: Option<String>,
+    serialized_effort: Option<String>,
+    context_tier: String,
+    status: String,
+    http_status: Option<u16>,
+    #[serde(default)]
+    stripped_parameters: Vec<String>,
+}
+
+fn read_record<T: serde::de::DeserializeOwned>(path: &Path) -> Option<T> {
+    let file = File::open(path).ok()?;
+    if file.metadata().ok()?.len() > MAX_STATUS_BYTES {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_STATUS_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    if bytes.len() as u64 > MAX_STATUS_BYTES {
+        return None;
+    }
+    serde_json::from_slice(bytes.strip_prefix(b"\xef\xbb\xbf").unwrap_or(&bytes)).ok()
+}
+
+fn label(value: &str) -> String {
+    value
+        .chars()
+        .filter(|character| !character.is_control())
+        .take(64)
+        .collect()
+}
+
+impl CopilotStatus {
+    fn refresh(&mut self, home: &Path, thread: Option<ThreadId>, now: Instant) -> bool {
+        if self.thread == thread
+            && self
+                .checked_at
+                .is_some_and(|last| now.duration_since(last) < REFRESH_INTERVAL)
+        {
+            return false;
+        }
+        self.checked_at = Some(now);
+        self.thread = thread;
+        let account = read_record::<Account>(&home.join("account-generation.json"));
+        let request = thread.and_then(|thread| {
+            let request = read_record::<Request>(
+                &home.join("request-status").join(format!("{thread}.json")),
+            )?;
+            (request.schema_version == 1 && request.thread_id == thread.to_string())
+                .then_some(request)
+        });
+        let changed = self.account != account || self.request != request;
+        self.account = account;
+        self.request = request;
+        changed
+    }
+
+    pub(super) fn account_text(&self) -> Option<String> {
+        let login = label(self.account.as_ref()?.login.as_deref()?);
+        (!login.is_empty()).then(|| format!("GitHub @{login}"))
+    }
+
+    pub(super) fn request_text(
+        &self,
+        model: &str,
+        effort: Option<&str>,
+        tier: &str,
+    ) -> Option<String> {
+        let account = self.account.as_ref()?;
+        let Some(request) = &self.request else {
+            return Some("Pending first request".to_string());
+        };
+        let matches = request.account_generation.as_deref() == Some(account.generation.as_str())
+            && (request.requested_model.as_deref() == Some(model)
+                || request.upstream_model.as_deref() == Some(model))
+            && request.serialized_effort.as_deref() == effort
+            && request.context_tier == tier;
+        if !matches {
+            return Some("Pending next request".to_string());
+        }
+        Some(match request.status.as_str() {
+            "started" => "Request in flight".to_string(),
+            "complete"
+                if request
+                    .http_status
+                    .is_some_and(|status| (200..300).contains(&status))
+                    && !request
+                        .stripped_parameters
+                        .iter()
+                        .any(|parameter| parameter.starts_with("reasoning")) =>
+            {
+                "Request verified".to_string()
+            }
+            "complete" => "Request completed (unverified)".to_string(),
+            "error" => "Last request failed".to_string(),
+            _ => "Request unverified".to_string(),
+        })
+    }
+}
+
+impl ChatWidget {
+    pub(super) fn refresh_copilot_status_if_due(&mut self) {
+        if self.config.model_provider_id != "github-copilot" {
+            return;
+        }
+        if self
+            .copilot_status
+            .refresh(&self.config.codex_home, self.thread_id, Instant::now())
+        {
+            self.refresh_status_line();
+        }
+        self.frame_requester.schedule_frame_in(REFRESH_INTERVAL);
+    }
+}
+
