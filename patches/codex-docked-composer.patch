+/// Keep spare terminal rows between live output and the composer, never below the footer.
+struct DockedComposer<'a> {
+    content: FlexRenderable<'a>,
+    composer: RenderableItem<'a>,
+}
+
+impl DockedComposer<'_> {
+    fn areas(&self, area: Rect) -> (Rect, Rect) {
+        let composer_height = self.composer.desired_height(area.width).min(area.height);
+        let content_height = area.height.saturating_sub(composer_height);
+        (
+            Rect::new(area.x, area.y, area.width, content_height),
+            Rect::new(
+                area.x,
+                area.y.saturating_add(content_height),
+                area.width,
+                composer_height,
+            ),
+        )
+    }
+}
+
+impl Renderable for DockedComposer<'_> {
+    fn render(&self, area: Rect, buf: &mut Buffer) {
+        let (content_area, composer_area) = self.areas(area);
+        self.content.render(content_area, buf);
+        self.composer.render(composer_area, buf);
+    }
+
+    fn desired_height(&self, width: u16) -> u16 {
+        self.content
+            .desired_height(width)
+            .saturating_add(self.composer.desired_height(width))
+    }
+
+    fn cursor_pos(&self, area: Rect) -> Option<(u16, u16)> {
+        self.composer.cursor_pos(self.areas(area).1)
+    }
+
+    fn cursor_style(&self, area: Rect) -> crossterm::cursor::SetCursorStyle {
+        self.composer.cursor_style(self.areas(area).1)
+    }
+}
+
 struct TranscriptAreaRenderable<'a> {
     child: &'a dyn HistoryCell,
     top: u16,
@@ -123,3 +169,7 @@ impl Renderable for ChatWidget {
         self.as_renderable().cursor_style(area)
     }
 }
