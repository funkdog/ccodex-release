@@ -0,0 +1,48 @@
+use super::*;
+use crate::app_event_sender::AppEventSender;
+use crate::bottom_pane::ChatComposer;
+use pretty_assertions::assert_eq;
+use ratatui::Terminal;
+use ratatui::backend::TestBackend;
+use tokio::sync::mpsc::unbounded_channel;
+
+#[test]
+fn live_output_stays_at_top_and_composer_fills_bottom() {
+    let (tx, _rx) = unbounded_channel::<AppEvent>();
+    let mut composer = ChatComposer::new(
+        /*has_input_focus*/ true,
+        AppEventSender::new(tx),
+        /*enhanced_keys_supported*/ true,
+        "Ask Codex".to_string(),
+        /*disable_paste_burst*/ true,
+    );
+    composer.set_text_content("editable draft".to_string(), Vec::new(), Vec::new());
+    composer.set_status_line_enabled(/*enabled*/ true);
+    composer.set_status_line(Some(Line::from(
+        "gpt-5.4 · Context 0/258K (0.0%) · Cache --",
+    )));
+    let mut content = FlexRenderable::new();
+    content.push(
+        /*flex*/ 1,
+        RenderableItem::Owned(Box::new(Line::from(
+            "Live output stays above the empty space",
+        ))),
+    );
+    let renderable = DockedComposer {
+        content,
+        composer: RenderableItem::Borrowed(&composer),
+    };
+    let mut terminal =
+        Terminal::new(TestBackend::new(/*width*/ 54, /*height*/ 18)).expect("terminal");
+    terminal
+        .draw(|frame| renderable.render(frame.area(), frame.buffer_mut()))
+        .expect("docked draw");
+
+    let (_, composer_area) = renderable.areas(Rect::new(0, 0, 54, 18));
+    assert_eq!(composer_area.bottom(), 18);
+    assert_eq!(
+        renderable.cursor_pos(Rect::new(0, 0, 54, 18)),
+        composer.cursor_pos(composer_area)
+    );
+    insta::assert_snapshot!(terminal.backend());
+}
