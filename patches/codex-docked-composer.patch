diff --git a/codex-rs/tui/src/tui/inline_layout_tests.rs b/codex-rs/tui/src/tui/inline_layout_tests.rs
new file mode 100644
index 0000000..44c7038
--- /dev/null
+++ b/codex-rs/tui/src/tui/inline_layout_tests.rs
@@ -0,0 +1,105 @@
+use super::*;
+use crate::insert_history::insert_history_lines;
+use crate::test_backend::VT100Backend;
+use pretty_assertions::assert_eq;
+use ratatui::text::Line;
+
+#[test]
+fn startup_fills_available_rows_and_repeated_frames_do_not_repaint() {
+    let backend = VT100Backend::new(/*width*/ 80, /*height*/ 24);
+    let mut terminal =
+        Terminal::with_options_and_cursor_position(backend, Position::new(/*x*/ 0, /*y*/ 3))
+            .expect("terminal");
+
+    assert!(
+        update_viewport(
+            &mut terminal,
+            /*desired_height*/ 6,
+            InlineLayout::Docked
+        )
+        .expect("initial viewport")
+    );
+    assert_eq!(terminal.viewport_area, Rect::new(0, 3, 80, 21));
+    assert!(
+        !update_viewport(
+            &mut terminal,
+            /*desired_height*/ 6,
+            InlineLayout::Docked
+        )
+        .expect("unchanged viewport")
+    );
+}
+
+#[test]
+fn history_grows_from_top_and_docking_does_not_move_it() {
+    let backend = VT100Backend::new(/*width*/ 40, /*height*/ 18);
+    let mut terminal =
+        Terminal::with_options_and_cursor_position(backend, Position::new(/*x*/ 0, /*y*/ 0))
+            .expect("terminal");
+    update_viewport(
+        &mut terminal,
+        /*desired_height*/ 5,
+        InlineLayout::Docked,
+    )
+    .expect("initial docking");
+    for text in ["first history row", "second history row"] {
+        update_viewport(
+            &mut terminal,
+            /*desired_height*/ 5,
+            InlineLayout::HistoryInsertion,
+        )
+        .expect("insertion area");
+        insert_history_lines(&mut terminal, vec![Line::from(text)]).expect("insert history");
+        update_viewport(
+            &mut terminal,
+            /*desired_height*/ 5,
+            InlineLayout::Docked,
+        )
+        .expect("restore docking");
+    }
+
+    assert_eq!(terminal.viewport_area, Rect::new(0, 2, 40, 16));
+    let rows: Vec<_> = terminal
+        .backend()
+        .vt100()
+        .screen()
+        .rows(/*start*/ 0, /*width*/ 40)
+        .collect();
+    assert_eq!(&rows[..2], &["first history row", "second history row"]);
+    assert!(rows[2..].iter().all(|row| row.trim().is_empty()));
+}
+
+#[test]
+fn tall_composer_reserves_bottom_rows_without_losing_history_tail() {
+    let backend = VT100Backend::new(/*width*/ 40, /*height*/ 18);
+    let mut terminal =
+        Terminal::with_options_and_cursor_position(backend, Position::new(/*x*/ 0, /*y*/ 0))
+            .expect("terminal");
+    update_viewport(
+        &mut terminal,
+        /*desired_height*/ 5,
+        InlineLayout::HistoryInsertion,
+    )
+    .expect("insertion area");
+    insert_history_lines(
+        &mut terminal,
+        (1..=30)
+            .map(|index| Line::from(format!("history {index:02}")))
+            .collect(),
+    )
+    .expect("history overflow");
+    update_viewport(
+        &mut terminal,
+        /*desired_height*/ 9,
+        InlineLayout::Docked,
+    )
+    .expect("tall composer");
+    assert_eq!(terminal.viewport_area, Rect::new(0, 9, 40, 9));
+    let rows: Vec<_> = terminal
+        .backend()
+        .vt100()
+        .screen()
+        .rows(/*start*/ 0, /*width*/ 40)
+        .collect();
+    assert_eq!(rows[8], "history 30");
+}
diff --git a/codex-rs/tui/src/tui/inline_layout.rs b/codex-rs/tui/src/tui/inline_layout.rs
new file mode 100644
index 0000000..9b5d34f
--- /dev/null
+++ b/codex-rs/tui/src/tui/inline_layout.rs
@@ -0,0 +1,52 @@
+//! Inline history keeps its native scrollback; only the live viewport fills the remaining screen.
+//!
+//! History insertion briefly uses the widget's minimum height so finalized rows can consume spare
+//! space below the transcript. Before painting, expand that same viewport to the terminal bottom.
+//! Ordinary redraws keep the expanded viewport unchanged, preserving incremental rendering.
+
+use std::io;
+use std::io::Write;
+
+use ratatui::backend::Backend;
+use ratatui::layout::Position;
+use ratatui::layout::Rect;
+
+use crate::custom_terminal::Terminal;
+
+pub(super) enum InlineLayout {
+    HistoryInsertion,
+    Docked,
+}
+
+pub(super) fn update_viewport<B: Backend + Write>(
+    terminal: &mut Terminal<B>,
+    desired_height: u16,
+    layout: InlineLayout,
+) -> io::Result<bool> {
+    let size = terminal.size()?;
+    let previous = terminal.viewport_area;
+    let minimum_height = desired_height.min(size.height);
+    let y = previous.y.min(size.height.saturating_sub(minimum_height));
+    let height = match layout {
+        InlineLayout::HistoryInsertion => minimum_height,
+        InlineLayout::Docked => size.height.saturating_sub(y),
+    };
+    let area = Rect::new(previous.x, y, size.width, height);
+    if area == previous {
+        return Ok(false);
+    }
+
+    // Resize reflow rebuilds rows after a terminal shrink; only widget growth moves history here.
+    if y < previous.y && size.height >= terminal.last_known_screen_size.height {
+        terminal
+            .backend_mut()
+            .scroll_region_up(0..previous.y, previous.y - y)?;
+    }
+    terminal.set_viewport_area(area);
+    terminal.clear_after_position(Position::new(/*x*/ 0, previous.y.min(y)))?;
+    Ok(true)
+}
+
+#[cfg(test)]
+#[path = "inline_layout_tests.rs"]
+mod tests;
