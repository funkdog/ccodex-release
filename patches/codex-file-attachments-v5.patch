+use super::*;
+use crate::history_cell::HistoryCell;
+use crate::history_cell::new_user_prompt;
+use pretty_assertions::assert_eq;
+use ratatui::Terminal;
+use ratatui::backend::TestBackend;
+use ratatui::widgets::Paragraph;
+
+#[test]
+fn attachment_projection_preserves_source_and_rebases_unicode_spans() {
+    let text = "\u{4e2d}\u{6587} [Image #2] '/tmp/report.docx' tail";
+    let image_start = text.find("[Image").unwrap();
+    let file_start = text.find('\'').unwrap();
+    let file_end = file_start + "'/tmp/report.docx'".len();
+    let file_label = "[\u{1f4c4} report.docx]";
+    let elements = vec![
+        TextElement::new(
+            (image_start..image_start + 10).into(),
+            Some("[Image #2]".into()),
+        ),
+        TextElement::new((file_start..file_end).into(), Some(file_label.into())),
+    ];
+    let (display, projected) =
+        display_user_attachments(text, &elements, &[PathBuf::from("/tmp/screen.png")], 1);
+    assert_eq!(
+        display,
+        "\u{4e2d}\u{6587} [\u{1f4f7} screen.png] [\u{1f4c4} report.docx] tail"
+    );
+    for element in &projected {
+        assert_eq!(
+            display.get(element.byte_range.start..element.byte_range.end),
+            element.placeholder(&display),
+        );
+    }
+    assert_eq!(
+        file_pastes(text, &elements),
+        vec![(file_label.into(), "'/tmp/report.docx'".into())]
+    );
+    assert_eq!(text, "\u{4e2d}\u{6587} [Image #2] '/tmp/report.docx' tail");
+}
+
+#[test]
+fn unstructured_literal_labels_are_not_rewritten() {
+    let source = "The string [Image #1] is not an attachment.";
+    assert_eq!(
+        display_user_attachments(source, &[], &[], 0),
+        (source.into(), vec![])
+    );
+}
+
+#[test]
+fn attachment_projection_ignores_invalid_and_overlapping_ranges() {
+    let source = "\u{4e2d} abc";
+    let elements = vec![
+        TextElement::new((1..3).into(), Some("invalid".into())),
+        TextElement::new((4..7).into(), Some("word".into())),
+        TextElement::new((5..20).into(), Some("overlap".into())),
+    ];
+    let labels = HashMap::from([("word".into(), "label".into())]);
+    assert_eq!(
+        project_labels(source, &elements, &labels),
+        (
+            "\u{4e2d} label".into(),
+            vec![TextElement::new((4..9).into(), Some("label".into()))],
+        ),
+    );
+}
+
+#[test]
+fn submitted_attachments_render_filename_labels_for_every_file() {
+    let source = "[Image #1] [Image #2] '/tmp/report.docx'";
+    let document = source.find('\'').unwrap();
+    let cell = new_user_prompt(
+        source.into(),
+        vec![
+            TextElement::new((0..10).into(), Some("[Image #1]".into())),
+            TextElement::new((11..21).into(), Some("[Image #2]".into())),
+            TextElement::new(
+                (document..source.len()).into(),
+                Some("[\u{1f4c4} report.docx]".into()),
+            ),
+        ],
+        vec![
+            PathBuf::from("/a/screen.png"),
+            PathBuf::from("/b/screen.png"),
+        ],
+        vec![],
+    );
+    let mut terminal = Terminal::new(TestBackend::new(70, 6)).unwrap();
+    terminal
+        .draw(|frame| {
+            frame.render_widget(Paragraph::new(cell.display_lines(70)), frame.area());
+        })
+        .unwrap();
+    insta::assert_snapshot!(terminal.backend());
+    assert_eq!(cell.message, source);
+}
