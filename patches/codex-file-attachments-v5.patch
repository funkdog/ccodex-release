+use super::*;
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use crate::history_cell::HistoryCell;
+use crate::history_cell::new_user_prompt;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use tokio::sync::mpsc::unbounded_channel;
+
+fn composer() -> ChatComposer {
+    let (tx, _rx) = unbounded_channel::<AppEvent>();
+    ChatComposer::new(
+        /*has_input_focus*/ true,
+        AppEventSender::new(tx),
+        /*enhanced_keys_supported*/ true,
+        "Ask Codex".into(),
+        /*disable_paste_burst*/ true,
+    )
+}
+
+#[test]
+fn attachment_paste_mixed_files_keep_the_same_labels_after_submission_and_restore() {
+    let root = tempfile::tempdir().unwrap();
+    let document = root.path().join("report.docx");
+    let data = root.path().join("data.csv");
+    let image = root.path().join("screen.png");
+    std::fs::write(&document, "fixture").unwrap();
+    std::fs::write(&data, "a,b\n1,2").unwrap();
+    image::RgbaImage::new(2, 2).save(&image).unwrap();
+    let pasted = [&document, &data, &image]
+        .into_iter()
+        .map(|path| quoted_path(path))
+        .collect::<Vec<_>>()
+        .join(" ");
+    let mut composer = composer();
+    composer.handle_paste(pasted);
+    let labels = "[\u{1f4c4} report.docx] [\u{1f4c4} data.csv] [\u{1f4f7} screen.png]";
+    assert_eq!(composer.current_text().trim(), labels);
+    assert_eq!(composer.local_image_paths(), vec![image.clone()]);
+
+    let (text, elements) = composer
+        .prepare_submission_text(/*record_history*/ true)
+        .unwrap();
+    assert_eq!(
+        text,
+        format!(
+            "{} {} [\u{1f4f7} screen.png]",
+            quoted_path(&document),
+            quoted_path(&data)
+        ),
+    );
+    let cell = new_user_prompt(text.clone(), elements.clone(), vec![image.clone()], vec![]);
+    let rendered = cell
+        .display_lines(120)
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(rendered.contains(labels), "{rendered}");
+    assert!(!rendered.contains(&root.path().to_string_lossy().to_string()));
+
+    composer.set_text_content(text.clone(), elements.clone(), vec![image]);
+    composer.set_pending_pastes(Vec::new());
+    assert_eq!(composer.current_text().trim(), labels);
+    assert_eq!(
+        composer.prepare_submission_text(/*record_history*/ false),
+        Some((text, elements)),
+    );
+}
