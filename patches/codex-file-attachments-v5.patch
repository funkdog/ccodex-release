+//! File drops use the existing atomic paste bindings; only their paths reach the model.
+
+use std::collections::HashMap;
+use std::path::PathBuf;
+use std::time::Duration;
+use std::time::Instant;
+
+use super::ChatComposer;
+use crate::attachment_label::AttachmentKind;
+use crate::attachment_label::attachment_label;
+use crate::attachment_label::file_pastes;
+use crate::attachment_label::project_labels;
+use crate::attachment_paths::pasted_paths;
+use crate::attachment_paths::quoted_path;
+use codex_protocol::user_input::TextElement;
+
+const DROP_SETTLE_TIME: Duration = Duration::from_millis(150);
+
+pub(super) struct RawAttachmentInput {
+    start: usize,
+    end: usize,
+    updated_at: Instant,
+}
+
+impl ChatComposer {
+    pub(super) fn handle_attachment_paths(&mut self, pasted: &str) -> bool {
+        let Some(paths) = pasted_paths(pasted) else {
+            return false;
+        };
+        self.insert_attachment_paths(paths);
+        true
+    }
+
+    fn insert_attachment_paths(&mut self, paths: Vec<PathBuf>) {
+        for path in paths {
+            if self.image_paste_enabled() && image::image_dimensions(&path).is_ok() {
+                self.attach_image(path);
+            } else {
+                let mut occurrence = 1;
+                let label = loop {
+                    let label = attachment_label(&path, AttachmentKind::File, occurrence);
+                    if !self
+                        .draft
+                        .pending_pastes
+                        .iter()
+                        .any(|(existing, _)| *existing == label)
+                    {
+                        break label;
+                    }
+                    occurrence += 1;
+                };
+                let value = quoted_path(&path);
+                self.draft.textarea.insert_element(&label);
+                self.draft.pending_pastes.push((label, value));
+            }
+            self.draft.textarea.insert_str(" ");
+        }
+    }
+
+    pub(super) fn note_raw_attachment_input(&mut self, start: usize, now: Instant) {
+        if !self.config.file_paste_enabled {
+            return;
+        }
+        let end = self.draft.textarea.cursor();
+        if end <= start {
+            self.raw_attachment_input = None;
+            return;
+        }
+        let start = self
+            .raw_attachment_input
+            .as_ref()
+            .filter(|previous| {
+                previous.end == start && now.duration_since(previous.updated_at) < DROP_SETTLE_TIME
+            })
+            .map(|previous| previous.start)
+            .unwrap_or(start);
+        self.raw_attachment_input = Some(RawAttachmentInput {
+            start,
+            end,
+            updated_at: now,
+        });
+        if let Some(requester) = &self.frame_requester {
+            requester.schedule_frame_in(DROP_SETTLE_TIME);
+        }
+    }
+
+    pub(crate) fn settle_attachment_input(&mut self, now: Instant) -> bool {
+        let Some(pending) = &self.raw_attachment_input else {
+            return false;
+        };
+        let elapsed = now.saturating_duration_since(pending.updated_at);
+        if elapsed < DROP_SETTLE_TIME {
+            if let Some(requester) = &self.frame_requester {
+                requester.schedule_frame_in(DROP_SETTLE_TIME - elapsed);
+            }
+            return false;
+        }
+        self.finish_attachment_input()
+    }
+
+    pub(super) fn finish_attachment_input(&mut self) -> bool {
+        let Some(pending) = self.raw_attachment_input.take() else {
+            return false;
+        };
+        let range = pending.start..pending.end;
+        if self.draft.textarea.cursor() != pending.end
+            || self
+                .draft
+                .textarea
+                .text_element_ranges_overlapping(range.clone())
+                .next()
+                .is_some()
+        {
+            return false;
+        }
+        let Some(text) = self.draft.textarea.text().get(range.clone()) else {
+            return false;
+        };
+        // Ordinary words such as a quickly typed LICENSE must not turn into attachments.
+        if !text.contains(['/', '\\']) && !text.starts_with(['\'', '"']) {
+            return false;
+        }
+        let Some(paths) = pasted_paths(text) else {
+            return false;
+        };
+        self.draft.textarea.replace_range(range, "");
+        self.draft.textarea.set_cursor(pending.start);
+        self.insert_attachment_paths(paths);
+        self.sync_popups();
+        true
+    }
+
+    pub(super) fn restore_file_labels(
+        &mut self,
+        text: String,
+        elements: Vec<TextElement>,
+    ) -> (String, Vec<TextElement>) {
+        let files = file_pastes(&text, &elements);
+        let labels: HashMap<String, String> = files
+            .iter()
+            .map(|(label, _)| (label.clone(), label.clone()))
+            .collect();
+        self.draft.pending_pastes.extend(files);
+        project_labels(&text, &elements, &labels)
+    }
+}
