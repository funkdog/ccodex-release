+//! Parse terminal file drops as an all-or-nothing path list, never as shell commands.
+
+use std::path::Path;
+use std::path::PathBuf;
+
+use crate::clipboard_paste::normalize_pasted_path;
+
+const MAX_DROP_BYTES: usize = 64 * 1024;
+const MAX_DROP_FILES: usize = 128;
+
+pub(crate) fn pasted_paths(pasted: &str) -> Option<Vec<PathBuf>> {
+    let pasted = pasted.trim();
+    if pasted.is_empty() || pasted.len() > MAX_DROP_BYTES {
+        return None;
+    }
+    // An unquoted filename may itself contain spaces.
+    if let Some(path) = existing_path(pasted) {
+        return Some(vec![path]);
+    }
+    let tokens = split_drop_paths(pasted)?;
+    if tokens.is_empty() || tokens.len() > MAX_DROP_FILES {
+        return None;
+    }
+    tokens
+        .into_iter()
+        .map(|token| existing_path(&token))
+        .collect()
+}
+
+fn existing_path(text: &str) -> Option<PathBuf> {
+    let literal = PathBuf::from(text);
+    if literal.is_file() {
+        return Some(literal);
+    }
+    let normalized = normalize_pasted_path(text)?;
+    normalized.is_file().then_some(normalized)
+}
+
+pub(crate) fn quoted_path(path: &Path) -> String {
+    let value = path.to_string_lossy();
+    #[cfg(windows)]
+    return format!("\"{value}\"");
+    #[cfg(not(windows))]
+    return format!("'{}'", value.replace('\'', "'\\''"));
+}
+
+fn split_drop_paths(input: &str) -> Option<Vec<String>> {
+    let input = input.strip_prefix("& ").unwrap_or(input);
+    let mut chars = input.chars().peekable();
+    let mut tokens = Vec::new();
+    let mut token = String::new();
+    let mut quote = None;
+    while let Some(character) = chars.next() {
+        if let Some(delimiter) = quote {
+            if character == delimiter {
+                if delimiter == '\'' && chars.peek() == Some(&'\'') {
+                    chars.next();
+                    token.push('\'');
+                } else {
+                    quote = None;
+                }
+            } else {
+                token.push(character);
+            }
+        } else if matches!(character, '\'' | '"') {
+            quote = Some(character);
+        } else if character.is_whitespace() {
+            if !token.is_empty() {
+                tokens.push(std::mem::take(&mut token));
+            }
+        } else if character == '\\'
+            && !token.starts_with('\\')
+            && token.as_bytes().get(1) != Some(&b':')
+            && chars
+                .peek()
+                .is_some_and(|next| next.is_whitespace() || matches!(next, '\'' | '"' | '\\'))
+        {
+            token.push(chars.next()?);
+        } else {
+            token.push(character);
+        }
+    }
+    if quote.is_some() {
+        return None;
+    }
+    if !token.is_empty() {
+        tokens.push(token);
+    }
+    Some(tokens)
+}
+
