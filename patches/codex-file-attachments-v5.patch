+#[test]
+fn immediate_submit_finishes_a_drop_but_never_changes_plain_typing() {
+    let root = tempfile::tempdir().unwrap();
+    let document = root.path().join("report.docx");
+    std::fs::write(&document, "fixture").unwrap();
+    let dropped = quoted_path(&document);
+    let mut composer = composer();
+    for character in dropped.chars() {
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+    let (text, elements) = composer.prepare_submission_text(false).unwrap();
+    assert_eq!(text, dropped);
+    assert!(
+        elements
+            .iter()
+            .any(|element| element.placeholder(&text) == Some("[\u{1f4c4} report.docx]"))
+    );
+    for character in "plain text, not a path".chars() {
+        composer.handle_key_event(KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE));
+    }
+    composer.settle_attachment_input(Instant::now() + Duration::from_secs(1));
+    assert_eq!(composer.current_text(), "plain text, not a path");
+}
