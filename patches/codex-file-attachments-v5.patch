+#[test]
+fn attachment_drop_key_records_are_recognized_without_buffering_typed_input() {
+    let root = tempfile::tempdir().unwrap();
+    let document = root.path().join("report.docx");
+    let data = root.path().join("data.csv");
+    std::fs::write(&document, "fixture").unwrap();
+    std::fs::write(&data, "fixture").unwrap();
+    let dropped = format!("{} {}", quoted_path(&document), quoted_path(&data));
+    let mut composer = composer();
+    composer.set_text_content("compare: ".into(), Vec::new(), Vec::new());
+    composer.move_cursor_to_end();
+    let start = Instant::now();
+    for (index, character) in dropped.chars().enumerate() {
+        composer.handle_input_basic_with_time(
+            KeyEvent::new(KeyCode::Char(character), KeyModifiers::NONE),
+            start + Duration::from_micros(index as u64),
+        );
+    }
+    assert_eq!(composer.current_text(), format!("compare: {dropped}"));
+    assert!(composer.settle_attachment_input(start + Duration::from_secs(1)));
+    assert_eq!(
+        composer.current_text(),
+        "compare: [\u{1f4c4} report.docx] [\u{1f4c4} data.csv] "
+    );
+    assert_eq!(
+        composer.prepare_submission_text(false).unwrap().0,
+        format!("compare: {dropped}")
+    );
+}
