+//! Filename labels are a display projection; model input retains canonical image IDs and paths.
+
+use std::collections::HashMap;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::models::local_image_label_text;
+use codex_protocol::user_input::TextElement;
+
+const FILE_PREFIX: &str = "[\u{1f4c4} ";
+
+#[derive(Clone, Copy)]
+pub(crate) enum AttachmentKind {
+    Image,
+    File,
+}
+
+pub(crate) fn attachment_name(path: &Path) -> String {
+    let name = path
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("attachment");
+    let sanitized: String = name
+        .chars()
+        .filter_map(|character| match character {
+            ']' => Some(')'),
+            character if character.is_control() => None,
+            character => Some(character),
+        })
+        .take(64)
+        .collect();
+    if sanitized.is_empty() {
+        "attachment".to_string()
+    } else {
+        sanitized
+    }
+}
+
+pub(crate) fn attachment_label(path: &Path, kind: AttachmentKind, occurrence: usize) -> String {
+    let name = attachment_name(path);
+    let icon = match kind {
+        AttachmentKind::Image => "\u{1f4f7}",
+        AttachmentKind::File => "\u{1f4c4}",
+    };
+    if occurrence <= 1 {
+        format!("[{icon} {name}]")
+    } else {
+        format!("[{icon} {name} \u{b7} {occurrence}]")
+    }
+}
+
+pub(crate) fn is_file_label(label: &str) -> bool {
+    label.starts_with(FILE_PREFIX)
+        && label.ends_with(']')
+        && label.len() <= 512
+        && !label.chars().any(char::is_control)
+}
+
+/// Recover file bindings from persisted path spans without requiring files to still exist.
+pub(crate) fn file_pastes(text: &str, elements: &[TextElement]) -> Vec<(String, String)> {
+    elements
+        .iter()
+        .filter_map(|element| {
+            let label = element.placeholder(text)?;
+            let actual = text.get(element.byte_range.start..element.byte_range.end)?;
+            (is_file_label(label)
+                && actual != label
+                && crate::clipboard_paste::normalize_pasted_path(actual).is_some())
+            .then(|| (label.to_string(), actual.to_string()))
+        })
+        .collect()
+}
+
+/// Replace only structured spans, rebasing all remaining elements without changing literal text.
+pub(crate) fn project_labels(
+    text: &str,
+    elements: &[TextElement],
+    labels: &HashMap<String, String>,
+) -> (String, Vec<TextElement>) {
+    let mut elements = elements.to_vec();
+    elements.sort_by_key(|element| element.byte_range.start);
+    let mut output = String::with_capacity(text.len());
+    let mut projected = Vec::with_capacity(elements.len());
+    let mut cursor = 0;
+    for element in elements {
+        let range = element.byte_range;
+        if range.start < cursor || range.start >= range.end {
+            continue;
+        }
+        let Some(prefix) = text.get(cursor..range.start) else {
+            continue;
+        };
+        let Some(original) = text.get(range.start..range.end) else {
+            continue;
+        };
+        output.push_str(prefix);
+        let start = output.len();
+        let replacement = element
+            .placeholder(text)
+            .and_then(|label| labels.get(label));
+        output.push_str(replacement.map(String::as_str).unwrap_or(original));
+        let mut element = element.map_range(|_| (start..output.len()).into());
+        if let Some(label) = replacement {
+            element.set_placeholder(Some(label.clone()));
+        }
+        projected.push(element);
+        cursor = range.end;
+    }
+    output.push_str(&text[cursor..]);
+    (output, projected)
+}
+
+pub(crate) fn display_user_attachments(
+    text: &str,
+    elements: &[TextElement],
+    images: &[PathBuf],
+    remote_count: usize,
+) -> (String, Vec<TextElement>) {
+    let mut text = text.to_string();
+    let mut elements = elements.to_vec();
+    let mut labels: HashMap<String, String> = file_pastes(&text, &elements)
+        .into_iter()
+        .map(|(label, _)| (label.clone(), label))
+        .collect();
+    let mut occurrences = HashMap::<String, usize>::new();
+    for (index, image) in images.iter().enumerate() {
+        let count = occurrences.entry(attachment_name(image)).or_default();
+        *count += 1;
+        let label = attachment_label(image, AttachmentKind::Image, *count);
+        let canonical = local_image_label_text(remote_count + index + 1);
+        let represented = elements.iter().any(|element| {
+            element
+                .placeholder(&text)
+                .is_some_and(|value| value == canonical || value == label)
+        });
+        if !represented {
+            let range = if let Some(start) = text.find(&canonical) {
+                start..start + canonical.len()
+            } else {
+                if !text.is_empty() {
+                    text.push(' ');
+                }
+                let start = text.len();
+                text.push_str(&canonical);
+                start..text.len()
+            };
+            elements.push(TextElement::new(range.into(), Some(canonical.clone())));
+        }
+        labels.insert(canonical, label);
+    }
+    project_labels(&text, &elements, &labels)
+}
+
