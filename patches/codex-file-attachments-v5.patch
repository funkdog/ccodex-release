+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn attachment_paths_accept_quoted_windows_and_shell_escaped_lists() {
+    assert_eq!(
+        split_drop_paths(r#""C:\My Files\a.png" "D:\Other\b.docx""#),
+        Some(vec![r"C:\My Files\a.png".into(), r"D:\Other\b.docx".into()]),
+    );
+    assert_eq!(
+        split_drop_paths(r"/tmp/My\ File.png '/tmp/report.docx'"),
+        Some(vec!["/tmp/My File.png".into(), "/tmp/report.docx".into()]),
+    );
+    assert_eq!(
+        split_drop_paths("& 'C:\\O''Brien\\one.docx' \"D:\\two.png\""),
+        Some(vec!["C:\\O'Brien\\one.docx".into(), "D:\\two.png".into()]),
+    );
+    assert_eq!(split_drop_paths("'unterminated"), None);
+}
+
+#[test]
+fn attachment_paths_require_the_entire_drop_to_be_regular_files() {
+    let root = tempfile::tempdir().unwrap();
+    let first = root.path().join("one file.docx");
+    let second = root.path().join("\u{4e2d}\u{6587}.csv");
+    std::fs::write(&first, "test").unwrap();
+    std::fs::write(&second, "test").unwrap();
+    let input = format!("{}\r\n{}", quoted_path(&first), quoted_path(&second));
+    assert_eq!(
+        pasted_paths(&input),
+        Some(vec![first.clone(), second.clone()])
+    );
+    assert_eq!(
+        pasted_paths(&format!("{} explain this", quoted_path(&first))),
+        None
+    );
+    assert_eq!(pasted_paths(&quoted_path(root.path())), None);
+    assert_eq!(
+        pasted_paths(&format!(
+            "{} {}",
+            quoted_path(&first),
+            quoted_path(&root.path().join("missing"))
+        )),
+        None
+    );
+    assert_eq!(pasted_paths(&first.to_string_lossy()), Some(vec![first]));
+    let url = url::Url::from_file_path(&second).unwrap();
+    assert_eq!(pasted_paths(url.as_str()), Some(vec![second]));
+}
+
+#[test]
+fn attachment_paths_do_not_run_shell_syntax() {
+    assert_eq!(pasted_paths("$(Get-Content credentials)"), None);
+    assert_eq!(pasted_paths("a.docx; rm -rf /"), None);
+}
