+        let area = Rect::new(0, 0, 20, 8);
+        let scroll_up = MouseEvent {
+            kind: MouseEventKind::ScrollUp,
+            column: 4,
+            row: 4,
+            modifiers: crossterm::event::KeyModifiers::NONE,
+        };
+        let scroll_down = MouseEvent {
+            kind: MouseEventKind::ScrollDown,
+            ..scroll_up
+        };
+
+        assert!(pv.handle_mouse_event(area, scroll_up));
+        let max_scroll = pv
+            .content_height(pv.content_area(area).width)
+            .saturating_sub(pv.content_area(area).height as usize);
+        assert_eq!(pv.scroll_offset, max_scroll - MOUSE_SCROLL_ROWS);
+
+        assert!(pv.handle_mouse_event(area, scroll_down));
+        assert_eq!(pv.scroll_offset, max_scroll);
+    }
 }
