+//! Mouse-driven transcript scrollback integrated with the live composer.
+//!
+//! Normal Codex rendering commits completed transcript cells to terminal scrollback and keeps only
+//! the live cell plus composer in the inline viewport. While mouse capture is enabled for native
+//! composer selection, wheel events cannot ask the terminal emulator to move that scrollback. This
+//! module provides an embedded transcript view instead: scrolling up enters the alternate buffer,
+//! renders transcript history above the real composer, and returns to the inline view automatically
+//! after scrolling back to the bottom. Keyboard and paste events continue to target the composer.
+
+use super::*;
+
+impl App {
+    pub(super) fn scrollback_overlay_active(&self) -> bool {
+        self.overlay.as_ref().is_some_and(Overlay::is_scrollback)
+    }
+
+    pub(super) fn open_scrollback_overlay(&mut self, tui: &mut tui::Tui) {
+        let _ = tui.enter_scrollback_screen();
+        self.overlay = Some(Overlay::new_scrollback(
+            self.transcript_cells.clone(),
+            self.keymap.pager.clone(),
+        ));
+        tui.frame_requester().schedule_frame();
+    }
+
+    pub(super) async fn handle_scrollback_event(
+        &mut self,
+        tui: &mut tui::Tui,
+        app_server: &mut AppServerSession,
+        event: TuiEvent,
+    ) -> Result<()> {
+        match event {
+            TuiEvent::Key(KeyEvent {
+                code: KeyCode::Esc,
+                kind: KeyEventKind::Press | KeyEventKind::Repeat,
+                ..
+            }) => self.close_transcript_overlay(tui),
+            TuiEvent::Key(key_event) => self.handle_key_event(tui, app_server, key_event).await,
+            TuiEvent::Paste(pasted) => self.handle_terminal_paste(pasted),
+            TuiEvent::Mouse(mouse) => {
+                if matches!(
+                    mouse.kind,
+                    crossterm::event::MouseEventKind::ScrollUp
+                        | crossterm::event::MouseEventKind::ScrollDown
+                ) {
+                    self.handle_scrollback_mouse(tui, mouse)?;
+                } else {
+                    self.chat_widget.handle_mouse_event(mouse);
+                }
+            }
+            TuiEvent::Draw | TuiEvent::Resize => {
+                self.chat_widget.maybe_post_pending_notification(tui);
+                if self
+                    .chat_widget
+                    .handle_paste_burst_tick(tui.frame_requester())
+                {
+                    return Ok(());
+                }
+                self.chat_widget.pre_draw_tick();
+                self.render_scrollback_frame(tui)?;
+                if self.chat_widget.external_editor_state() == ExternalEditorState::Requested {
+                    self.chat_widget
+                        .set_external_editor_state(ExternalEditorState::Active);
+                    self.app_event_tx.send(AppEvent::LaunchExternalEditor);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn handle_scrollback_mouse(
+        &mut self,
+        tui: &mut tui::Tui,
+        mouse: crossterm::event::MouseEvent,
+    ) -> Result<()> {
+        let terminal_size = tui.terminal.size()?;
+        let full_area = Rect::new(0, 0, terminal_size.width, terminal_size.height);
+        let composer_height = self
+            .chat_widget
+            .composer_as_renderable()
+            .desired_height(full_area.width);
+        let (_, history_area) = scrollback_areas(full_area, composer_height);
+        let Some(Overlay::Transcript(transcript)) = &mut self.overlay else {
+            return Ok(());
+        };
+        if transcript.handle_scrollback_mouse(history_area, mouse) {
+            tui.frame_requester()
+                .schedule_frame_in(crate::tui::TARGET_FRAME_INTERVAL);
+        }
+        let returned_to_bottom = matches!(mouse.kind, crossterm::event::MouseEventKind::ScrollDown)
+            && transcript.is_scrolled_to_bottom_in(history_area);
+        if returned_to_bottom {
+            self.close_transcript_overlay(tui);
+        }
+        Ok(())
+    }
+
+    fn render_scrollback_frame(&mut self, tui: &mut tui::Tui) -> Result<()> {
+        let active_key = self.chat_widget.active_cell_transcript_key();
+        let chat_widget = &self.chat_widget;
+        let composer = chat_widget.composer_as_renderable();
+        let composer_height = composer.desired_height(tui.terminal.size()?.width);
+        let Some(Overlay::Transcript(transcript)) = &mut self.overlay else {
+            return Ok(());
+        };
+
+        tui.draw(u16::MAX, |frame| {
+            let (composer_area, history_area) = scrollback_areas(frame.area(), composer_height);
+            transcript.sync_live_tail(history_area.width.max(1), active_key, |width| {
+                chat_widget.active_cell_transcript_hyperlink_lines(width)
+            });
+            transcript.render_scrollback(history_area, frame.buffer);
+            composer.render(composer_area, frame.buffer);
+            chat_widget.note_rendered_width(composer_area.width);
+            if let Some((x, y)) = composer.cursor_pos(composer_area) {
+                frame.set_cursor_style(composer.cursor_style(composer_area));
+                frame.set_cursor_position((x, y));
+            }
+        })?;
+        if active_key.is_some_and(|key| key.animation_tick.is_some())
+            && transcript.is_scrolled_to_bottom()
+        {
+            tui.frame_requester()
+                .schedule_frame_in(std::time::Duration::from_millis(50));
+        }
+        Ok(())
+    }
+}
+
+fn scrollback_areas(area: Rect, desired_composer_height: u16) -> (Rect, Rect) {
+    let composer_height = desired_composer_height.min(area.height);
+    let history_height = area.height.saturating_sub(composer_height);
+    let history_area = Rect::new(area.x, area.y, area.width, history_height);
+    let composer_area = Rect::new(
+        area.x,
+        area.y.saturating_add(history_height),
+        area.width,
+        composer_height,
+    );
+    (composer_area, history_area)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::app_event_sender::AppEventSender;
+    use crate::bottom_pane::ChatComposer;
+    use crate::history_cell::AgentMessageCell;
+    use crate::history_cell::new_user_prompt;
+    use crate::pager_overlay::TranscriptOverlay;
+    use insta::assert_snapshot;
+    use pretty_assertions::assert_eq;
+    use ratatui::Terminal;
+    use ratatui::backend::TestBackend;
+    use std::sync::Arc;
+    use tokio::sync::mpsc::unbounded_channel;
+
+    #[test]
+    fn composer_stays_pinned_to_bottom_while_history_uses_remaining_rows() {
+        let area = Rect::new(3, 5, 80, 24);
+        let (composer, history) = scrollback_areas(area, 6);
+
+        assert_eq!(history, Rect::new(3, 5, 80, 18));
+        assert_eq!(composer, Rect::new(3, 23, 80, 6));
+        assert_eq!(composer.bottom(), area.bottom());
+    }
+
+    #[test]
+    fn embedded_scrollback_keeps_live_composer_and_omits_pager_chrome() {
+        let cells: Vec<Arc<dyn HistoryCell>> = vec![
+            Arc::new(new_user_prompt(
+                "Show me the earlier context".to_string(),
+                Vec::new(),
+                Vec::new(),
+                Vec::new(),
+            )),
+            Arc::new(AgentMessageCell::new(
+                (1..=14)
+                    .map(|line| Line::from(format!("history line {line:02}")))
+                    .collect(),
+                /*is_first_line*/ true,
+            )),
+        ];
+        let mut transcript =
+            TranscriptOverlay::new_scrollback(cells, RuntimeKeymap::defaults().pager);
+        let (tx, _rx) = unbounded_channel::<AppEvent>();
+        let mut composer = ChatComposer::new(
+            /*has_input_focus*/ true,
+            AppEventSender::new(tx),
+            /*enhanced_keys_supported*/ true,
+            "Ask Codex to do anything".to_string(),
+            /*disable_paste_burst*/ false,
+        );
+        composer.set_text_content(
+            "composer remains editable".to_string(),
+            Vec::new(),
+            Vec::new(),
+        );
+        composer.set_status_line_enabled(/*enabled*/ true);
+        composer.set_status_line(Some(Line::from(
+            "gpt-5.6-sol xhigh · Context 123K/258K (47.7%) · Cache 88.4%",
+        )));
+
+        let mut terminal = Terminal::new(TestBackend::new(50, 18)).expect("terminal");
+        terminal
+            .draw(|frame| {
+                let composer_height = composer.desired_height(frame.area().width);
+                let (composer_area, history_area) = scrollback_areas(frame.area(), composer_height);
+                transcript.render_scrollback(history_area, frame.buffer_mut());
+                composer.render(composer_area, frame.buffer_mut());
+            })
+            .expect("initial draw");
+        let (_, history_area) = scrollback_areas(
+            Rect::new(0, 0, 50, 18),
+            composer.desired_height(/*width*/ 50),
+        );
+        transcript.handle_scrollback_mouse(
+            history_area,
+            crossterm::event::MouseEvent {
+                kind: crossterm::event::MouseEventKind::ScrollUp,
+                column: 4,
+                row: 4,
+                modifiers: KeyModifiers::NONE,
+            },
+        );
+        terminal
+            .draw(|frame| {
+                let composer_height = composer.desired_height(frame.area().width);
+                let (composer_area, history_area) = scrollback_areas(frame.area(), composer_height);
+                transcript.render_scrollback(history_area, frame.buffer_mut());
+                composer.render(composer_area, frame.buffer_mut());
+            })
+            .expect("scrolled draw");
+
+        assert_snapshot!(terminal.backend());
+    }
+}
