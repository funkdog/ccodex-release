+#[test]
+fn quota_is_current_account_remaining_and_marks_unknown_stale_and_unlimited() {
+    let root = tempfile::tempdir().unwrap();
+    let file = root.path().join("account-generation.json");
+    let mut account = json!({
+        "generation": "one", "login": "test-user",
+        "quota": {
+            "status": "available", "updatedAt": chrono::Utc::now().to_rfc3339(),
+            "snapshots": [{ "id": "premium_interactions", "unlimited": false,
+                "remaining": 0, "entitlement": 300, "percentRemaining": 0 }]
+        }
+    });
+    let mut status = CopilotStatus::default();
+    let now = Instant::now();
+    std::fs::write(&file, account.to_string()).unwrap();
+    status.refresh(root.path(), None, now);
+    assert_eq!(status.quota_text().as_deref(), Some("Copilot 0/300 left"));
+    account["quota"]["snapshots"][0]["remaining"] = json!(240);
+    account["quota"]["snapshots"][0]["percentRemaining"] = json!(80);
+    account["quota"]["status"] = json!("stale");
+    std::fs::write(&file, account.to_string()).unwrap();
+    status.refresh(root.path(), None, now + REFRESH_INTERVAL);
+    assert_eq!(
+        status.quota_text().as_deref(),
+        Some("Copilot 240/300 left (stale)")
+    );
+    account["quota"]["snapshots"][0]["unlimited"] = json!(true);
+    account["quota"]["status"] = json!("available");
+    std::fs::write(&file, account.to_string()).unwrap();
+    status.refresh(root.path(), None, now + REFRESH_INTERVAL * 2);
+    assert_eq!(status.quota_text().as_deref(), Some("Copilot unlimited"));
+    account["generation"] = json!("two");
+    account["login"] = json!("other-user");
+    account["quota"] = serde_json::Value::Null;
+    std::fs::write(&file, account.to_string()).unwrap();
+    status.refresh(root.path(), None, now + REFRESH_INTERVAL * 3);
+    assert_eq!(status.account_text().as_deref(), Some("GitHub @other-user"));
+    assert_eq!(
+        status.quota_text().as_deref(),
+        Some("Copilot quota unavailable")
+    );
+}
