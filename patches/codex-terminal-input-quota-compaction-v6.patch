@@ -0,0 +1,232 @@
+//! Recover CSI-u keys delivered as individual Win32 console records.
+
+use crossterm::event::Event;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyEventKind;
+use crossterm::event::KeyModifiers;
+
+#[derive(Default)]
+pub(super) struct WindowsKeySequence {
+    pending: Vec<Event>,
+    text: String,
+    raw_paste: bool,
+}
+
+fn packets() -> impl Iterator<Item = (String, Option<KeyEvent>)> {
+    (1_u8..=8)
+        .flat_map(|modifier| {
+            let bits = modifier - 1;
+            let mut modifiers = KeyModifiers::NONE;
+            if bits & 1 != 0 {
+                modifiers |= KeyModifiers::SHIFT;
+            }
+            if bits & 2 != 0 {
+                modifiers |= KeyModifiers::ALT;
+            }
+            if bits & 4 != 0 {
+                modifiers |= KeyModifiers::CONTROL;
+            }
+            [
+                ("u", KeyEventKind::Press),
+                (":1u", KeyEventKind::Press),
+                (":2u", KeyEventKind::Repeat),
+                (":3u", KeyEventKind::Release),
+            ]
+            .into_iter()
+            .map(move |(suffix, kind)| {
+                (
+                    format!("\u{1b}[13;{modifier}{suffix}"),
+                    Some(KeyEvent::new_with_kind(KeyCode::Enter, modifiers, kind)),
+                )
+            })
+            .chain(std::iter::once((
+                format!("\u{1b}[27;{modifier};13~"),
+                Some(KeyEvent::new(KeyCode::Enter, modifiers)),
+            )))
+        })
+        .chain([
+            ("\u{1b}[200~".to_string(), None),
+            ("\u{1b}[201~".to_string(), None),
+        ])
+}
+
+impl WindowsKeySequence {
+    pub(super) fn is_pending(&self) -> bool {
+        !self.pending.is_empty()
+    }
+
+    pub(super) fn flush(&mut self) -> Vec<Event> {
+        self.text.clear();
+        std::mem::take(&mut self.pending)
+    }
+
+    pub(super) fn push(&mut self, event: Event) -> Vec<Event> {
+        let character = match &event {
+            Event::Key(key)
+                if key.kind != KeyEventKind::Release
+                    && !key
+                        .modifiers
+                        .intersects(KeyModifiers::CONTROL | KeyModifiers::ALT) =>
+            {
+                match key.code {
+                    KeyCode::Esc => Some('\u{1b}'),
+                    KeyCode::Char(character) if character.is_ascii() => Some(character),
+                    _ => None,
+                }
+            }
+            _ => None,
+        };
+        if !self.is_pending() {
+            if character != Some('\u{1b}') {
+                return vec![event];
+            }
+        } else if matches!(&event, Event::Key(key) if key.kind == KeyEventKind::Release) {
+            if self.pending.len() >= 64 {
+                let mut ready = self.flush();
+                ready.push(event);
+                return ready;
+            }
+            self.pending.push(event);
+            return Vec::new();
+        }
+        let Some(character) = character else {
+            let mut ready = self.flush();
+            ready.push(event);
+            return ready;
+        };
+        self.pending.push(event);
+        self.text.push(character);
+        let mut possible = false;
+        for (packet, key) in packets() {
+            if self.raw_paste && packet != "\u{1b}[201~" {
+                continue;
+            }
+            if packet == self.text {
+                if packet == "\u{1b}[200~" {
+                    self.raw_paste = true;
+                    return self.flush();
+                }
+                if packet == "\u{1b}[201~" {
+                    self.raw_paste = false;
+                    return self.flush();
+                }
+                self.pending.clear();
+                self.text.clear();
+                return key.map(Event::Key).into_iter().collect();
+            }
+            possible |= packet.starts_with(&self.text);
+        }
+        if possible { Vec::new() } else { self.flush() }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn events(text: &str) -> Vec<Event> {
+        text.chars()
+            .map(|character| {
+                Event::Key(KeyEvent::new(
+                    if character == '\u{1b}' {
+                        KeyCode::Esc
+                    } else {
+                        KeyCode::Char(character)
+                    },
+                    KeyModifiers::NONE,
+                ))
+            })
+            .collect()
+    }
+
+    fn decode(decoder: &mut WindowsKeySequence, text: &str) -> Vec<Event> {
+        events(text)
+            .into_iter()
+            .flat_map(|event| decoder.push(event))
+            .collect()
+    }
+
+    #[test]
+    fn csi_u_and_modify_other_keys_preserve_shift_enter() {
+        for packet in ["\u{1b}[13;2u", "\u{1b}[13;2:1u", "\u{1b}[27;2;13~"] {
+            let mut decoder = WindowsKeySequence::default();
+            assert_eq!(
+                decode(&mut decoder, packet),
+                vec![Event::Key(KeyEvent::new(
+                    KeyCode::Enter,
+                    KeyModifiers::SHIFT,
+                ))]
+            );
+            assert!(!decoder.is_pending());
+        }
+    }
+
+    #[test]
+    fn all_packet_splits_keep_one_logical_key_and_no_literal_suffix() {
+        let packet = "\u{1b}[13;2u";
+        for split in 0..=packet.len() {
+            let mut decoder = WindowsKeySequence::default();
+            let mut output = decode(&mut decoder, &packet[..split]);
+            output.extend(decode(&mut decoder, &packet[split..]));
+            assert_eq!(
+                output,
+                vec![Event::Key(KeyEvent::new(
+                    KeyCode::Enter,
+                    KeyModifiers::SHIFT,
+                ))]
+            );
+        }
+    }
+
+    #[test]
+    fn release_and_repeat_keep_their_kind_without_duplicating_presses() {
+        let mut decoder = WindowsKeySequence::default();
+        assert_eq!(
+            decode(&mut decoder, "\u{1b}[13;2:2u\u{1b}[13;2:3u"),
+            vec![
+                Event::Key(KeyEvent::new_with_kind(
+                    KeyCode::Enter,
+                    KeyModifiers::SHIFT,
+                    KeyEventKind::Repeat
+                )),
+                Event::Key(KeyEvent::new_with_kind(
+                    KeyCode::Enter,
+                    KeyModifiers::SHIFT,
+                    KeyEventKind::Release
+                )),
+            ]
+        );
+    }
+
+    #[test]
+    fn unknown_escape_mouse_keys_and_resize_are_not_lost_or_rewritten() {
+        let mut decoder = WindowsKeySequence::default();
+        let unknown = "\u{1b}[31m";
+        assert_eq!(decode(&mut decoder, unknown), events(unknown));
+        assert_eq!(decode(&mut decoder, "\u{1b}"), Vec::new());
+        let resize = Event::Resize(80, 24);
+        let mut expected = events("\u{1b}");
+        expected.push(resize.clone());
+        assert_eq!(decoder.push(resize), expected);
+        assert!(!decoder.is_pending());
+    }
+
+    #[test]
+    fn actual_paste_and_raw_bracketed_paste_do_not_decode_embedded_keyboard_text() {
+        let mut decoder = WindowsKeySequence::default();
+        let paste = Event::Paste("\u{1b}[13;2u".to_string());
+        assert_eq!(decoder.push(paste.clone()), vec![paste]);
+        let raw = "\u{1b}[200~literal \u{1b}[13;2u\u{1b}[201~";
+        assert_eq!(decode(&mut decoder, raw), events(raw));
+    }
+
+    #[test]
+    fn incomplete_sequence_flushes_every_original_event_exactly_once() {
+        let mut decoder = WindowsKeySequence::default();
+        assert!(decode(&mut decoder, "\u{1b}[13;").is_empty());
+        assert_eq!(decoder.flush(), events("\u{1b}[13;"));
+        assert!(decoder.flush().is_empty());
+    }
+}
