+    let mut status = CopilotStatus::default();
+    for (index, updated_at) in [
+        "invalid".to_string(),
+        (chrono::Utc::now() - chrono::Duration::minutes(16)).to_rfc3339(),
+        (chrono::Utc::now() + chrono::Duration::minutes(6)).to_rfc3339(),
