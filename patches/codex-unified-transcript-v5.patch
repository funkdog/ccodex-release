@@ -0,0 +1,40 @@
+//! Full-screen transcript frames do not write a second, independently scrolling history buffer.
+
+use super::*;
+
+impl Tui {
+    pub(crate) fn set_docked_transcript_enabled(&mut self, enabled: bool) {
+        self.docked_transcript_enabled = enabled;
+        self.pending_history_lines.clear();
+    }
+
+    pub(crate) fn draw_transcript(
+        &mut self,
+        draw_fn: impl FnOnce(&mut custom_terminal::Frame),
+    ) -> Result<()> {
+        self.enter_alt_screen()?;
+        #[cfg(unix)]
+        let mut prepared_resume = self
+            .suspend_context
+            .prepare_resume_action(&mut self.alt_saved_viewport);
+        ensure_virtual_terminal_processing()?;
+        stdout().sync_update(|_| {
+            #[cfg(unix)]
+            if let Some(prepared) = prepared_resume.take() {
+                prepared.apply(&mut self.terminal)?;
+            }
+            let size = self.terminal.size()?;
+            let area = Rect::new(0, 0, size.width, size.height);
+            if self.terminal.viewport_area != area {
+                self.terminal.set_viewport_area(area);
+                // A reset diff buffer assumes blanks already exist on the physical screen.
+                self.terminal.clear_visible_screen()?;
+            }
+            self.pending_history_lines.clear();
+            #[cfg(unix)]
+            self.suspend_context
+                .set_cursor_y(size.height.saturating_sub(1));
+            self.terminal.draw(draw_fn)
+        })?
+    }
+}
