@@ -0,0 +1,42 @@
+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn scrollbar_and_drag_share_the_actual_viewport_range() {
+    let bottom = Scrollbar::new(100, 20, 80);
+    assert_eq!(
+        bottom,
+        Scrollbar {
+            top: 16,
+            length: 4,
+            travel: 16,
+            max_scroll: 80
+        }
+    );
+    assert_eq!(bottom.offset_at(16), 80);
+    assert_eq!(bottom.offset_at(8), 40);
+    assert_eq!(bottom.offset_at(0), 0);
+    assert_eq!(Scrollbar::new(100, 20, bottom.offset_at(8)).top, 8);
+}
+
+#[test]
+fn scrollbar_handles_empty_short_and_zero_height_viewports() {
+    assert_eq!(
+        Scrollbar::new(0, 0, 0),
+        Scrollbar {
+            top: 0,
+            length: 0,
+            travel: 0,
+            max_scroll: 0
+        }
+    );
+    assert_eq!(
+        Scrollbar::new(3, 20, 10),
+        Scrollbar {
+            top: 0,
+            length: 20,
+            travel: 0,
+            max_scroll: 0
+        }
+    );
+}
diff --git a/codex-rs/tui/src/transcript_view/scrollbar.rs b/codex-rs/tui/src/transcript_view/scrollbar.rs
new file mode 100644
index 0000000..8c457f0
--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/scrollbar.rs
@@ -0,0 +1,48 @@
+//! The same row offset drives the scrollbar's thumb, hit testing and drag conversion.
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) struct Scrollbar {
+    pub(super) top: usize,
+    pub(super) length: usize,
+    pub(super) travel: usize,
+    pub(super) max_scroll: usize,
+}
+
+impl Scrollbar {
+    pub(super) fn new(total: usize, height: usize, offset: usize) -> Self {
+        let max_scroll = total.saturating_sub(height);
+        let length = if total == 0 || height == 0 {
+            height
+        } else {
+            height
+                .saturating_mul(height)
+                .checked_div(total)
+                .unwrap_or(0)
+                .clamp(1, height.max(1))
+        };
+        let travel = height.saturating_sub(length);
+        let top = offset
+            .min(max_scroll)
+            .saturating_mul(travel)
+            .checked_div(max_scroll)
+            .unwrap_or(0);
+        Self {
+            top,
+            length,
+            travel,
+            max_scroll,
+        }
+    }
+
+    pub(super) fn offset_at(self, position: usize) -> usize {
+        position
+            .min(self.travel)
+            .saturating_mul(self.max_scroll)
+            .checked_div(self.travel)
+            .unwrap_or(0)
+    }
+}
+
+#[cfg(test)]
+#[path = "scrollbar_tests.rs"]
+mod tests;
