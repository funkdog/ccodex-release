+use super::*;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn output_selection_never_splits_cjk_combining_marks_or_emoji() {
+    let text = "a\u{4e2d}e\u{301}\u{1f600}b";
+    assert_eq!(snap_column(text, 2), 1);
+    assert_eq!(snap_column(text, 5), 4);
+    assert_eq!(slice_columns(text, 1..6), "\u{4e2d}e\u{301}\u{1f600}");
+    let family = "x\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}y";
+    assert_eq!(snap_column(family, 2), 1);
+    assert_eq!(
+        slice_columns(family, 1..3),
+        "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}"
+    );
+}
+
+#[test]
+fn reverse_drag_selects_the_same_columns_as_forward_drag() {
+    let start = Point { row: 2, column: 3 };
+    let end = Point { row: 4, column: 7 };
+    let forward = Selection {
+        anchor: start,
+        focus: end,
+    };
+    let backward = Selection {
+        anchor: end,
+        focus: start,
+    };
+    for row in 0..6 {
+        assert_eq!(forward.columns(row, 20), backward.columns(row, 20));
+    }
+    assert_eq!(forward.columns(2, 20), Some(3..20));
+    assert_eq!(forward.columns(3, 20), Some(0..20));
+    assert_eq!(forward.columns(4, 20), Some(0..7));
+}
