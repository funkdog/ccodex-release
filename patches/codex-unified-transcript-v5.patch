+use super::*;
+use pretty_assertions::assert_eq;
+use ratatui::text::Line;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+
+#[derive(Debug)]
+struct CountedCell {
+    renders: Arc<AtomicUsize>,
+    stable: bool,
+}
+
+impl HistoryCell for CountedCell {
+    fn display_lines(&self, _width: u16) -> Vec<Line<'static>> {
+        self.renders.fetch_add(1, Ordering::Relaxed);
+        vec!["unchanged output".into()]
+    }
+
+    fn raw_lines(&self) -> Vec<Line<'static>> {
+        vec!["raw output".into()]
+    }
+
+    fn has_stable_transcript_height(&self) -> bool {
+        self.stable
+    }
+}
+
+#[test]
+fn a_dynamic_card_does_not_rebuild_later_stable_cells() {
+    let dynamic_renders = Arc::new(AtomicUsize::new(0));
+    let stable_renders = Arc::new(AtomicUsize::new(0));
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![
+        Arc::new(CountedCell {
+            renders: Arc::clone(&dynamic_renders),
+            stable: false,
+        }),
+        Arc::new(CountedCell {
+            renders: Arc::clone(&stable_renders),
+            stable: true,
+        }),
+    ];
+    let mut buffer = TranscriptBuffer::default();
+    buffer.sync(&cells, 60, HistoryRenderMode::Rich);
+    let before = buffer.rows.clone();
+    assert!(matches!(
+        buffer.sync(&cells, 60, HistoryRenderMode::Rich),
+        BufferChange::Unchanged
+    ));
+    assert_eq!(dynamic_renders.load(Ordering::Relaxed), 2);
+    assert_eq!(stable_renders.load(Ordering::Relaxed), 1);
+    assert_eq!(buffer.rows, before);
+    assert!(matches!(
+        buffer.sync(&cells, 30, HistoryRenderMode::Rich),
+        BufferChange::Layout
+    ));
+    assert_eq!(stable_renders.load(Ordering::Relaxed), 2);
+    buffer.layout.as_mut().unwrap().syntax_theme_revision =
+        crate::render::highlight::syntax_theme_revision().wrapping_sub(1);
+    assert!(matches!(
+        buffer.sync(&cells, 30, HistoryRenderMode::Rich),
+        BufferChange::Layout
+    ));
+    assert_eq!(stable_renders.load(Ordering::Relaxed), 3);
+    buffer.sync(&cells[..1], 30, HistoryRenderMode::Raw);
+    assert_eq!(buffer.rows, vec![HyperlinkLine::from("raw output")]);
+    buffer.sync(&[], 30, HistoryRenderMode::Rich);
+    assert_eq!(buffer.rows, Vec::<HyperlinkLine>::new());
+}
