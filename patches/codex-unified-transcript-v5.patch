+use super::*;
+use crate::history_cell::PlainHistoryCell;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+use ratatui::style::Color;
+use ratatui::text::Line;
+
+fn cell(lines: impl IntoIterator<Item = String>) -> Arc<dyn HistoryCell> {
+    Arc::new(PlainHistoryCell::new(
+        lines
+            .into_iter()
+            .map(|line| Line::from(line.cyan()))
+            .collect(),
+    ))
+}
+
+fn mouse(kind: MouseEventKind, column: u16, row: u16) -> MouseEvent {
+    MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+
+fn render(view: &mut TranscriptView, width: u16, height: u16) -> Buffer {
+    let area = Rect::new(0, 0, width, height);
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer);
+    buffer
+}
+
+#[test]
+fn live_output_and_scrolled_output_have_identical_styles() {
+    let mut view = TranscriptView::default();
+    let cells = vec![cell((0..12).map(|row| format!("line {row:02}")))];
+    view.sync(&cells, 40, HistoryRenderMode::Rich, None, |_| None);
+    let before = render(&mut view, 41, 6);
+    assert_eq!(before[(0, 0)].fg, Color::Cyan);
+    view.handle_mouse(mouse(MouseEventKind::ScrollUp, 10, 2));
+    render(&mut view, 41, 6);
+    view.handle_mouse(mouse(MouseEventKind::ScrollDown, 10, 2));
+    let after = render(&mut view, 41, 6);
+    assert_eq!(before, after);
+    assert!(view.following());
+}
+
+#[test]
+fn new_output_follows_only_when_the_user_has_not_scrolled_away() {
+    let mut view = TranscriptView::default();
+    let mut cells = vec![cell((0..12).map(|row| format!("line {row:02}")))];
+    view.sync(&cells, 40, HistoryRenderMode::Rich, None, |_| None);
+    render(&mut view, 41, 6);
+    assert_eq!(view.offset, 6);
+    view.handle_mouse(mouse(MouseEventKind::ScrollUp, 10, 2));
+    assert_eq!(view.offset, 3);
+    cells.push(cell(["new output".into()]));
+    view.sync(&cells, 40, HistoryRenderMode::Rich, None, |_| None);
+    render(&mut view, 41, 6);
+    assert_eq!(view.offset, 3);
+    view.jump_to_latest();
+    render(&mut view, 41, 6);
+    assert_eq!(view.offset, 8);
+}
+
+#[test]
+fn output_drag_selection_is_stable_while_streaming_cells_are_replaced() {
+    let mut view = TranscriptView::default();
+    let cells = vec![cell([
+        "alpha \u{4e2d} beta".into(),
+        "second caf\u{e9}".into(),
+        "last".into(),
+    ])];
+    view.sync(&cells, 40, HistoryRenderMode::Rich, None, |_| None);
+    render(&mut view, 41, 6);
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 6, 0));
+    view.handle_mouse(mouse(MouseEventKind::Drag(MouseButton::Left), 6, 1));
+    view.handle_mouse(mouse(MouseEventKind::Up(MouseButton::Left), 6, 1));
+    let selected = "\u{4e2d} beta\nsecond";
+    assert_eq!(view.selected_text().as_deref(), Some(selected));
+    let highlighted = render(&mut view, 41, 6);
+    assert!(highlighted[(6, 0)].modifier.contains(Modifier::REVERSED));
+    assert!(highlighted[(7, 0)].modifier.contains(Modifier::REVERSED));
+    view.sync(
+        &[cell(["consolidated output".into()])],
+        40,
+        HistoryRenderMode::Rich,
+        None,
+        |_| None,
+    );
+    assert_eq!(view.selected_text().as_deref(), Some(selected));
+    assert_eq!(render(&mut view, 41, 6), highlighted);
+    assert!(
+        matches!(view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Right), 8, 1)), MouseAction::Copy(text) if text == selected)
+    );
+    view.jump_to_latest();
+    assert_eq!(view.selected_text(), None);
+    assert_eq!(view.row(0).unwrap().line.to_string(), "consolidated output");
+}
+
+#[test]
+fn output_selection_extends_across_wheel_and_edge_autoscroll() {
+    let mut view = TranscriptView::default();
+    view.sync(
+        &[cell((0..20).map(|row| format!("row {row:02}")))],
+        40,
+        HistoryRenderMode::Rich,
+        None,
+        |_| None,
+    );
+    render(&mut view, 41, 6);
+    for _ in 0..10 {
+        view.handle_mouse(mouse(MouseEventKind::ScrollUp, 5, 2));
+    }
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 0, 1));
+    view.handle_mouse(mouse(MouseEventKind::Drag(MouseButton::Left), 6, 4));
+    view.handle_mouse(mouse(MouseEventKind::ScrollDown, 6, 4));
+    assert_eq!(view.offset, 3);
+    assert_eq!(view.selected_text().unwrap().lines().count(), 7);
+    view.handle_mouse(mouse(MouseEventKind::Drag(MouseButton::Left), 6, 5));
+    view.autoscroll(view.last_autoscroll + AUTOSCROLL_INTERVAL);
+    assert!(view.selected_text().unwrap().contains("row 09"));
+    assert!(!view.following());
+}
+
+#[test]
+fn output_scrollbar_click_and_drag_reach_the_same_latest_row() {
+    let mut view = TranscriptView::default();
+    view.sync(
+        &[cell((0..100).map(|row| format!("row {row:02}")))],
+        40,
+        HistoryRenderMode::Rich,
+        None,
+        |_| None,
+    );
+    render(&mut view, 41, 10);
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 40, 0));
+    assert_eq!(view.offset, 0);
+    view.handle_mouse(mouse(MouseEventKind::Drag(MouseButton::Left), 40, 9));
+    view.handle_mouse(mouse(MouseEventKind::Up(MouseButton::Left), 40, 9));
+    assert_eq!(view.offset, 90);
+    assert!(view.following());
+    let buffer = render(&mut view, 41, 10);
+    assert_eq!(buffer[(40, 9)].symbol(), "\u{2503}");
+    assert_eq!(buffer[(0, 0)].symbol(), "r");
+}
+
+#[test]
+fn transcript_selection_snapshot() {
+    let mut view = TranscriptView::default();
+    view.sync(
+        &[cell([
+            "Rich output".into(),
+            "select \u{4e2d}\u{6587} safely".into(),
+            "copy without interrupting".into(),
+        ])],
+        40,
+        HistoryRenderMode::Rich,
+        None,
+        |_| None,
+    );
+    render(&mut view, 41, 6);
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 7, 1));
+    view.handle_mouse(mouse(MouseEventKind::Drag(MouseButton::Left), 4, 2));
+    view.handle_mouse(mouse(MouseEventKind::Up(MouseButton::Left), 4, 2));
+    insta::assert_debug_snapshot!(render(&mut view, 41, 6));
+}
+
+#[test]
+fn startup_live_tail_refreshes_even_without_a_revision_change() {
+    let mut view = TranscriptView::default();
+    let key = Some(ActiveCellTranscriptKey {
+        revision: 0,
+        is_stream_continuation: false,
+        animation_tick: None,
+    });
+    view.sync(&[], 40, HistoryRenderMode::Rich, key, |_| {
+        Some(vec![HyperlinkLine::from("loading")])
+    });
+    render(&mut view, 41, 6);
+    view.sync(&[], 40, HistoryRenderMode::Rich, key, |_| {
+        Some(vec![HyperlinkLine::from("selected model")])
+    });
+    assert_eq!(view.row(0).unwrap().line.to_string(), "selected model");
+}
+
+#[test]
+fn styled_history_background_covers_the_same_row_as_the_composer() {
+    let mut view = TranscriptView::default();
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![Arc::new(PlainHistoryCell::new(vec![
+        Line::from("attachment").bg(Color::DarkGray),
+    ]))];
+    view.sync(&cells, 40, HistoryRenderMode::Rich, None, |_| None);
+    let buffer = render(&mut view, 41, 6);
+    assert_eq!(buffer[(39, 0)].bg, Color::DarkGray);
+    assert_eq!(buffer[(40, 0)].bg, Color::Reset);
+}
