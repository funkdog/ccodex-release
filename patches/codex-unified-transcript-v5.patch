new file mode 100644
index 0000000..4e9ff0d
--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/buffer.rs
@@ -0,0 +1,136 @@
+//! Cache cells independently so a changing status card cannot invalidate a long transcript.
+
+use std::sync::Arc;
+
+use crate::history_cell::HistoryCell;
+use crate::history_cell::HistoryRenderMode;
+use crate::render::line_utils::line_to_static;
+use crate::terminal_hyperlinks::HyperlinkLine;
+use crate::terminal_hyperlinks::remap_wrapped_line;
+use crate::wrapping::RtOptions;
+use crate::wrapping::word_wrap_line;
+
+pub(super) enum BufferChange {
+    Unchanged,
+    Content,
+    Layout,
+}
+
+struct CachedCell {
+    source: Arc<dyn HistoryCell>,
+    lines: Vec<HyperlinkLine>,
+    continuation: bool,
+}
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct Layout {
+    width: u16,
+    mode: HistoryRenderMode,
+    syntax_theme_revision: u64,
+    foreground: Option<(u8, u8, u8)>,
+    background: Option<(u8, u8, u8)>,
+}
+
+#[derive(Default)]
+pub(super) struct TranscriptBuffer {
+    cells: Vec<CachedCell>,
+    ends: Vec<usize>,
+    layout: Option<Layout>,
+    pub(super) rows: Vec<HyperlinkLine>,
+}
+
+impl TranscriptBuffer {
+    pub(super) fn sync(
+        &mut self,
+        cells: &[Arc<dyn HistoryCell>],
+        width: u16,
+        mode: HistoryRenderMode,
+    ) -> BufferChange {
+        let layout = Layout {
+            width,
+            mode,
+            syntax_theme_revision: crate::render::highlight::syntax_theme_revision(),
+            foreground: crate::terminal_palette::default_fg(),
+            background: crate::terminal_palette::default_bg(),
+        };
+        let layout_changed = self.layout != Some(layout);
+        self.layout = Some(layout);
+        let mut first_changed = None;
+        for (index, source) in cells.iter().enumerate() {
+            let cached = self.cells.get_mut(index);
+            if !layout_changed
+                && cached.as_ref().is_some_and(|cached| {
+                    Arc::ptr_eq(&cached.source, source) && source.has_stable_transcript_height()
+                })
+            {
+                continue;
+            }
+            let lines = wrap_rows(source.display_hyperlink_lines_for_mode(width, mode), width);
+            let continuation = source.is_stream_continuation();
+            if let Some(cached) = cached {
+                if cached.lines != lines || cached.continuation != continuation || layout_changed {
+                    first_changed.get_or_insert(index);
+                    cached.lines = lines;
+                    cached.continuation = continuation;
+                }
+                cached.source = Arc::clone(source);
+            } else {
+                first_changed.get_or_insert(index);
+                self.cells.push(CachedCell {
+                    source: Arc::clone(source),
+                    lines,
+                    continuation,
+                });
+            }
+        }
+        if self.cells.len() > cells.len() {
+            first_changed.get_or_insert(cells.len());
+            self.cells.truncate(cells.len());
+        }
+        if let Some(start) = first_changed {
+            self.rows.truncate(
+                start
+                    .checked_sub(1)
+                    .map(|index| self.ends[index])
+                    .unwrap_or(0),
+            );
+            self.ends.truncate(start);
+            for cell in &self.cells[start..] {
+                if !cell.lines.is_empty() {
+                    if !self.rows.is_empty() && !cell.continuation {
+                        self.rows.push(HyperlinkLine::from(""));
+                    }
+                    self.rows.extend(cell.lines.iter().cloned());
+                }
+                self.ends.push(self.rows.len());
+            }
+        }
+        if layout_changed {
+            BufferChange::Layout
+        } else if first_changed.is_some() {
+            BufferChange::Content
+        } else {
+            BufferChange::Unchanged
+        }
+    }
+}
+
+pub(super) fn wrap_rows(lines: Vec<HyperlinkLine>, width: u16) -> Vec<HyperlinkLine> {
+    let mut rows = Vec::new();
+    for line in lines {
+        if line.width() <= usize::from(width) {
+            rows.push(line);
+        } else {
+            let wrapped = word_wrap_line(&line.line, RtOptions::new(usize::from(width.max(1))))
+                .iter()
+                .map(line_to_static)
+                .collect();
+            rows.extend(remap_wrapped_line(&line, wrapped));
+        }
+    }
+    rows
+}
+
+#[cfg(test)]
+#[path = "buffer_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/transcript_view/mod.rs b/codex-rs/tui/src/transcript_view/mod.rs
new file mode 100644
index 0000000..dae3aee
--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/mod.rs
@@ -0,0 +1,380 @@
+//! One source-backed viewport owns live output, scroll position, selection and its scrollbar.
+//!
+//! Stable committed cells are cached by Arc identity and width. A selection freezes its visible
+//! document while live cells continue updating offscreen, so consolidation cannot change copied
+//! text under the pointer. Returning to the live tail releases that snapshot.
+
+use std::sync::Arc;
+use std::time::Duration;
+use std::time::Instant;
+
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Modifier;
+use ratatui::style::Stylize;
+use ratatui::widgets::Clear;
+use ratatui::widgets::Paragraph;
+use ratatui::widgets::Widget;
+use ratatui::widgets::WidgetRef;
+
+use crate::chatwidget::ActiveCellTranscriptKey;
+use crate::clipboard_copy::ClipboardLease;
+use crate::history_cell::HistoryCell;
+use crate::history_cell::HistoryRenderMode;
+use crate::terminal_hyperlinks::HyperlinkLine;
+use crate::terminal_hyperlinks::mark_buffer_hyperlinks;
+
+mod buffer;
+mod scrollbar;
+mod selection;
+use buffer::BufferChange;
+use buffer::TranscriptBuffer;
+use buffer::wrap_rows;
+use scrollbar::Scrollbar;
+use selection::Point;
+use selection::Selection;
+use selection::slice_columns;
+use selection::snap_column;
+
+const WHEEL_ROWS: usize = 3;
+const AUTOSCROLL_INTERVAL: Duration = Duration::from_millis(60);
+
+pub(crate) enum MouseAction {
+    Unhandled,
+    Redraw,
+    Copy(String),
+}
+
+pub(crate) struct TranscriptView {
+    committed: TranscriptBuffer,
+    tail: Vec<HyperlinkLine>,
+    area: Rect,
+    offset: usize,
+    following: bool,
+    selection: Option<Selection>,
+    selected_document: Option<Vec<HyperlinkLine>>,
+    drag_pointer: Option<(u16, u16)>,
+    drag_was_following: bool,
+    thumb_grab: Option<usize>,
+    last_autoscroll: Instant,
+    pub(crate) clipboard_lease: Option<ClipboardLease>,
+}
+
+impl Default for TranscriptView {
+    fn default() -> Self {
+        Self {
+            committed: TranscriptBuffer::default(),
+            tail: Vec::new(),
+            area: Rect::default(),
+            offset: 0,
+            following: true,
+            selection: None,
+            selected_document: None,
+            drag_pointer: None,
+            drag_was_following: true,
+            thumb_grab: None,
+            last_autoscroll: Instant::now(),
+            clipboard_lease: None,
+        }
+    }
+}
+
+impl TranscriptView {
+    pub(crate) fn sync(
+        &mut self,
+        cells: &[Arc<dyn HistoryCell>],
+        width: u16,
+        mode: HistoryRenderMode,
+        tail_key: Option<ActiveCellTranscriptKey>,
+        live_lines: impl FnOnce(u16) -> Option<Vec<HyperlinkLine>>,
+    ) {
+        let change = self.committed.sync(cells, width, mode);
+        if matches!(change, BufferChange::Layout) {
+            // A physical-column selection cannot be reinterpreted at another width.
+            self.clear_selection();
+        }
+        // Startup headers and delayed hooks can change without a transcript revision bump.
+        // Only the small live tail is rendered each frame; committed history remains cached.
+        self.tail = live_lines(width)
+            .map(|lines| wrap_rows(lines, width))
+            .unwrap_or_default();
+        if !self.tail.is_empty()
+            && !self.committed.rows.is_empty()
+            && tail_key.is_some_and(|key| !key.is_stream_continuation)
+        {
+            self.tail.insert(0, HyperlinkLine::from(""));
+        }
+        self.clamp_offset();
+    }
+
+    fn row_count(&self) -> usize {
+        self.selected_document
+            .as_ref()
+            .map_or(self.committed.rows.len() + self.tail.len(), Vec::len)
+    }
+
+    fn row(&self, index: usize) -> Option<&HyperlinkLine> {
+        if let Some(document) = &self.selected_document {
+            document.get(index)
+        } else if index < self.committed.rows.len() {
+            self.committed.rows.get(index)
+        } else {
+            self.tail.get(index - self.committed.rows.len())
+        }
+    }
+
+    fn clamp_offset(&mut self) {
+        let max_scroll = self
+            .row_count()
+            .saturating_sub(usize::from(self.area.height));
+        self.offset = if self.following {
+            max_scroll
+        } else {
+            self.offset.min(max_scroll)
+        };
+    }
+
+    pub(crate) fn following(&self) -> bool {
+        self.following
+    }
+
+    pub(crate) fn jump_to_latest(&mut self) {
+        self.clear_selection();
+        self.following = true;
+        self.thumb_grab = None;
+        self.clamp_offset();
+    }
+
+    pub(crate) fn clear_selection(&mut self) {
+        self.selection = None;
+        self.selected_document = None;
+        self.drag_pointer = None;
+    }
+
+    pub(crate) fn has_selection(&self) -> bool {
+        self.selection
+            .is_some_and(|selection| selection.anchor != selection.focus)
+    }
+
+    pub(crate) fn reset(&mut self) {
+        let lease = self.clipboard_lease.take();
+        *self = Self::default();
+        self.clipboard_lease = lease;
+    }
+
+    pub(crate) fn selected_text(&self) -> Option<String> {
+        let selection = self.selection?;
+        let (start, end) = selection.ordered();
+        if start == end {
+            return None;
+        }
+        let text = (start.row..=end.row)
+            .filter_map(|index| {
+                let row = self.row(index)?;
+                let columns = selection.columns(index, row.width())?;
+                Some(
+                    slice_columns(&row.line.to_string(), columns)
+                        .trim_end()
+                        .to_string(),
+                )
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        (!text.is_empty()).then_some(text)
+    }
+
+    pub(crate) fn render(&mut self, area: Rect, buffer: &mut Buffer) {
+        self.area = Rect::new(area.x, area.y, area.width.saturating_sub(1), area.height);
+        self.clamp_offset();
+        Clear.render(area, buffer);
+        for visible_row in 0..usize::from(area.height) {
+            let index = self.offset + visible_row;
+            let Some(row) = self.row(index) else { break };
+            let row_area = Rect::new(area.x, area.y + visible_row as u16, self.area.width, 1);
+            Paragraph::new(row.line.clone())
+                .style(row.line.style)
+                .render(row_area, buffer);
+            mark_buffer_hyperlinks(
+                buffer,
+                row_area,
+                std::slice::from_ref(row),
+                /*scroll_rows*/ 0,
+            );
+            if let Some(columns) = self
+                .selection
+                .and_then(|selection| selection.columns(index, usize::from(self.area.width)))
+            {
+                for column in columns {
+                    buffer[(area.x + column as u16, row_area.y)]
+                        .modifier
+                        .insert(Modifier::REVERSED);
+                }
+            }
+        }
+        if area.width > 0 && area.height > 0 && self.row_count() > usize::from(area.height) {
+            let bar = Scrollbar::new(self.row_count(), usize::from(area.height), self.offset);
+            let x = area.right() - 1;
+            for y in 0..usize::from(area.height) {
+                let symbol = if (bar.top..bar.top + bar.length).contains(&y) {
+                    "\u{2503}".cyan()
+                } else {
+                    "\u{2502}".dim()
+                };
+                symbol.render_ref(Rect::new(x, area.y + y as u16, 1, 1), buffer);
+            }
+        }
+    }
+
+    fn point_at(&self, column: u16, row: u16) -> Option<Point> {
+        let visible = row
+            .saturating_sub(self.area.y)
+            .min(self.area.height.saturating_sub(1));
+        let requested = self.offset + usize::from(visible);
+        let index = requested.min(self.row_count().saturating_sub(1));
+        let text = self.row(index)?.line.to_string();
+        Some(Point {
+            row: index,
+            column: if requested >= self.row_count() {
+                self.row(index)?.width()
+            } else {
+                snap_column(&text, usize::from(column.saturating_sub(self.area.x)))
+            },
+        })
+    }
+
+    fn scroll(&mut self, direction: isize) {
+        let max_scroll = self
+            .row_count()
+            .saturating_sub(usize::from(self.area.height));
+        self.offset = self.offset.saturating_add_signed(direction).min(max_scroll);
+        self.following = self.offset == max_scroll && self.selected_document.is_none();
+    }
+
+    pub(crate) fn handle_mouse(&mut self, event: MouseEvent) -> MouseAction {
+        if self.area.height == 0 {
+            return MouseAction::Unhandled;
+        }
+        let in_rows = event.row >= self.area.y && event.row < self.area.bottom();
+        match event.kind {
+            MouseEventKind::ScrollUp | MouseEventKind::ScrollDown => {
+                let direction = if event.kind == MouseEventKind::ScrollUp {
+                    -1
+                } else {
+                    1
+                };
+                self.scroll(direction * WHEEL_ROWS as isize);
+                if self.drag_pointer.is_some() {
+                    self.drag_pointer = Some((event.column, event.row));
+                    self.extend_selection();
+                }
+            }
+            MouseEventKind::Down(MouseButton::Left)
+                if in_rows && event.column == self.area.right() =>
+            {
+                let bar =
+                    Scrollbar::new(self.row_count(), usize::from(self.area.height), self.offset);
+                let position = usize::from(event.row - self.area.y);
+                let grab = if (bar.top..bar.top + bar.length).contains(&position) {
+                    position - bar.top
+                } else {
+                    bar.length / 2
+                };
+                self.offset = bar.offset_at(position.saturating_sub(grab));
+                self.following = self.offset == bar.max_scroll && self.selected_document.is_none();
+                self.thumb_grab = Some(grab);
+            }
+            MouseEventKind::Down(MouseButton::Left)
+                if in_rows && event.column < self.area.right() =>
+            {
+                self.clear_selection();
+                let Some(point) = self.point_at(event.column, event.row) else {
+                    return MouseAction::Unhandled;
+                };
+                self.selected_document = Some(
+                    self.committed
+                        .rows
+                        .iter()
+                        .chain(&self.tail)
+                        .cloned()
+                        .collect(),
+                );
+                self.drag_was_following = self.following;
+                self.following = false;
+                self.selection = Some(Selection {
+                    anchor: point,
+                    focus: point,
+                });
+                self.drag_pointer = Some((event.column, event.row));
+            }
+            MouseEventKind::Drag(MouseButton::Left) if self.thumb_grab.is_some() => {
+                let bar =
+                    Scrollbar::new(self.row_count(), usize::from(self.area.height), self.offset);
+                let position = usize::from(event.row.saturating_sub(self.area.y));
+                self.offset = bar.offset_at(position.saturating_sub(self.thumb_grab.unwrap_or(0)));
+                self.following = self.offset == bar.max_scroll && self.selected_document.is_none();
+            }
+            MouseEventKind::Drag(MouseButton::Left) if self.drag_pointer.is_some() => {
+                self.drag_pointer = Some((event.column, event.row));
+                self.autoscroll(Instant::now());
+                self.extend_selection();
+            }
+            MouseEventKind::Up(MouseButton::Left)
+                if self.drag_pointer.is_some() || self.thumb_grab.is_some() =>
+            {
+                if self.drag_pointer.is_some() {
+                    self.drag_pointer = Some((event.column, event.row));
+                    self.extend_selection();
+                    if self.selected_text().is_none() {
+                        self.clear_selection();
+                        self.following = self.drag_was_following;
+                    }
+                }
+                self.drag_pointer = None;
+                self.thumb_grab = None;
+            }
+            MouseEventKind::Down(MouseButton::Right) => {
+                if let Some(text) = self.selected_text() {
+                    return MouseAction::Copy(text);
+                }
+                return MouseAction::Unhandled;
+            }
+            _ => return MouseAction::Unhandled,
+        }
+        MouseAction::Redraw
+    }
+
+    fn extend_selection(&mut self) {
+        if let Some((column, row)) = self.drag_pointer
+            && let Some(point) = self.point_at(column, row)
+            && let Some(selection) = &mut self.selection
+        {
+            selection.focus = point;
+        }
+    }
+
+    pub(crate) fn autoscroll(&mut self, now: Instant) -> bool {
+        let Some((_, row)) = self.drag_pointer else {
+            return false;
+        };
+        let direction = if row <= self.area.y {
+            -1
+        } else if row >= self.area.bottom().saturating_sub(1) {
+            1
+        } else {
+            return false;
+        };
+        if now.duration_since(self.last_autoscroll) >= AUTOSCROLL_INTERVAL {
+            self.last_autoscroll = now;
+            self.scroll(direction);
+            self.extend_selection();
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+#[path = "tests.rs"]
+mod tests;
