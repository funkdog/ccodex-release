+//! Selection boundaries use display columns, never UTF-8 byte offsets or partial graphemes.
+
+use std::ops::Range;
+
+use unicode_segmentation::UnicodeSegmentation;
+use unicode_width::UnicodeWidthStr;
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub(super) struct Point {
+    pub(super) row: usize,
+    pub(super) column: usize,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Selection {
+    pub(super) anchor: Point,
+    pub(super) focus: Point,
+}
+
+impl Selection {
+    pub(super) fn ordered(self) -> (Point, Point) {
+        (self.anchor.min(self.focus), self.anchor.max(self.focus))
+    }
+
+    pub(super) fn columns(self, row: usize, width: usize) -> Option<Range<usize>> {
+        let (start, end) = self.ordered();
+        if start == end || row < start.row || row > end.row {
+            return None;
+        }
+        let first = if row == start.row { start.column } else { 0 };
+        let last = if row == end.row { end.column } else { width };
+        Some(first.min(width)..last.min(width))
+    }
+}
+
+pub(super) fn snap_column(text: &str, column: usize) -> usize {
+    let mut offset = 0;
+    for grapheme in text.graphemes(true) {
+        let end = offset + grapheme.width();
+        if column < end {
+            return offset;
+        }
+        offset = end;
+    }
+    offset
+}
+
+pub(super) fn slice_columns(text: &str, columns: Range<usize>) -> String {
+    let mut offset = 0;
+    text.graphemes(true)
+        .filter(|grapheme| {
+            let start = offset;
+            offset += grapheme.width();
+            start >= columns.start && start < columns.end
+        })
+        .collect()
+}
+
+#[cfg(test)]
+#[path = "selection_tests.rs"]
+mod tests;
