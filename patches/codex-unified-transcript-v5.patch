diff --git a/codex-rs/tui/src/app/docked_transcript_tests.rs b/codex-rs/tui/src/app/docked_transcript_tests.rs
new file mode 100644
index 0000000..a700779
--- /dev/null
+++ b/codex-rs/tui/src/app/docked_transcript_tests.rs
@@ -0,0 +1,71 @@
+use super::*;
+use crate::history_cell::PlainHistoryCell;
+use crate::transcript_view::TranscriptView;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use pretty_assertions::assert_eq;
+
+fn mouse(kind: MouseEventKind, column: u16, row: u16) -> TuiEvent {
+    TuiEvent::Mouse(MouseEvent {
+        kind,
+        column,
+        row,
+        modifiers: KeyModifiers::NONE,
+    })
+}
+
+#[tokio::test]
+async fn output_copy_is_consumed_before_composer_or_interrupt_handling() {
+    let mut app = super::super::test_support::make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+    app.chat_widget
+        .handle_paste("draft remains unchanged".into());
+    let before = app.chat_widget.composer_text_with_pending();
+    let mut view = TranscriptView::default();
+    view.sync(
+        &[Arc::new(PlainHistoryCell::new(vec!["output text".into()]))],
+        40,
+        history_cell::HistoryRenderMode::Rich,
+        None,
+        |_| None,
+    );
+    view.render(
+        Rect::new(0, 0, 41, 6),
+        &mut ratatui::buffer::Buffer::empty(Rect::new(0, 0, 41, 6)),
+    );
+    app.transcript_view = Some(view);
+    for event in [
+        mouse(MouseEventKind::Down(MouseButton::Left), 0, 0),
+        mouse(MouseEventKind::Drag(MouseButton::Left), 6, 0),
+        mouse(MouseEventKind::Up(MouseButton::Left), 6, 0),
+    ] {
+        assert!(
+            app.handle_docked_transcript_input_with_copy(&mut tui, &event, |_| panic!(
+                "not a copy"
+            ))
+        );
+    }
+    let mut copied = String::new();
+    assert!(app.handle_docked_transcript_input_with_copy(
+        &mut tui,
+        &TuiEvent::Key(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL)),
+        |text| {
+            copied = text.into();
+            Ok(None)
+        },
+    ));
+    assert_eq!(copied, "output");
+    assert_eq!(app.chat_widget.composer_text_with_pending(), before);
+    assert!(app.handle_docked_transcript_input_with_copy(
+        &mut tui,
+        &TuiEvent::Key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)),
+        |_| panic!("not a copy"),
+    ));
+    assert!(app.transcript_view.as_ref().unwrap().following());
+    assert!(!app.handle_docked_transcript_input_with_copy(
+        &mut tui,
+        &TuiEvent::Key(KeyEvent::new(KeyCode::Down, KeyModifiers::NONE)),
+        |_| panic!("not a copy"),
+    ));
+}
diff --git a/codex-rs/tui/src/app/docked_transcript.rs b/codex-rs/tui/src/app/docked_transcript.rs
new file mode 100644
index 0000000..6930dbb
--- /dev/null
+++ b/codex-rs/tui/src/app/docked_transcript.rs
@@ -0,0 +1,174 @@
+//! Route output selection before composer input, and render both over one row coordinate space.
+
+use super::*;
+use crate::transcript_view::MouseAction;
+use ratatui::widgets::Widget;
+
+impl App {
+    pub(super) fn handle_docked_transcript_input(
+        &mut self,
+        tui: &mut tui::Tui,
+        event: &TuiEvent,
+    ) -> bool {
+        self.handle_docked_transcript_input_with_copy(
+            tui,
+            event,
+            crate::clipboard_copy::copy_to_clipboard,
+        )
+    }
+
+    fn handle_docked_transcript_input_with_copy(
+        &mut self,
+        tui: &mut tui::Tui,
+        event: &TuiEvent,
+        copy_text: impl FnOnce(
+            &str,
+        ) -> std::result::Result<
+            Option<crate::clipboard_copy::ClipboardLease>,
+            String,
+        >,
+    ) -> bool {
+        if !self.chat_widget.no_modal_or_popup_active() {
+            return false;
+        }
+        let Some(view) = &mut self.transcript_view else {
+            return false;
+        };
+        let mut copy = None;
+        match event {
+            TuiEvent::Key(key)
+                if matches!(key.kind, KeyEventKind::Press | KeyEventKind::Repeat) =>
+            {
+                let copy_key = key.modifiers.contains(KeyModifiers::CONTROL)
+                    && matches!(key.code, KeyCode::Char('c' | 'C') | KeyCode::Insert);
+                if copy_key && view.has_selection() {
+                    copy = view.selected_text();
+                } else if key.code == KeyCode::Down && key.modifiers.is_empty() && !view.following()
+                {
+                    view.jump_to_latest();
+                } else if key.code == KeyCode::Esc && view.has_selection() {
+                    view.clear_selection();
+                } else {
+                    if matches!(
+                        key.code,
+                        KeyCode::Char(_) | KeyCode::Enter | KeyCode::Backspace
+                    ) {
+                        view.clear_selection();
+                    }
+                    return false;
+                }
+            }
+            TuiEvent::Mouse(mouse) => match view.handle_mouse(*mouse) {
+                MouseAction::Copy(text) => copy = Some(text),
+                MouseAction::Redraw => {}
+                MouseAction::Unhandled => {
+                    if matches!(mouse.kind, crossterm::event::MouseEventKind::Down(_)) {
+                        view.clear_selection();
+                    }
+                    return false;
+                }
+            },
+            TuiEvent::Paste(_) => {
+                view.clear_selection();
+                return false;
+            }
+            _ => return false,
+        }
+        if let Some(text) = copy {
+            match copy_text(&text) {
+                Ok(lease) => view.clipboard_lease = lease,
+                Err(error) => self
+                    .chat_widget
+                    .add_error_message(format!("Failed to copy selection: {error}")),
+            }
+        }
+        tui.frame_requester().schedule_frame();
+        true
+    }
+
+    pub(super) fn render_docked_chat_frame(&mut self, tui: &mut tui::Tui) -> Result<Rect> {
+        let width = tui.terminal.size()?.width;
+        let chat = &self.chat_widget;
+        let composer = chat.composer_as_renderable();
+        let composer_height = composer.desired_height(width);
+        let active_key = chat.active_cell_transcript_key();
+        let view = self
+            .transcript_view
+            .as_mut()
+            .ok_or_else(|| color_eyre::eyre::eyre!("docked transcript is not initialized"))?;
+        view.sync(
+            &self.transcript_cells,
+            width.saturating_sub(1).max(1),
+            chat.history_render_mode(),
+            active_key,
+            |width| chat.active_cell_view_hyperlink_lines(width),
+        );
+        let autoscrolling = view.autoscroll(Instant::now());
+        let mut rendered = Rect::default();
+        tui.draw_transcript(|frame| {
+            let area = frame.area();
+            let height = composer_height.min(area.height);
+            let history = Rect::new(
+                area.x,
+                area.y,
+                area.width,
+                area.height.saturating_sub(height),
+            );
+            let input = Rect::new(area.x, history.bottom(), area.width, height);
+            view.render(history, frame.buffer);
+            composer.render(input, frame.buffer);
+            if !view.following() && input.height > 0 {
+                let hint = if view.has_selection() {
+                    "Selection paused \u{b7} Ctrl+C / right-click copy \u{b7} \u{2193} latest"
+                } else {
+                    "Scrolled \u{b7} \u{2193} latest"
+                };
+                ratatui::widgets::Paragraph::new(hint.cyan()).render(
+                    Rect::new(input.x + 1, input.y, input.width.saturating_sub(1), 1),
+                    frame.buffer,
+                );
+            }
+            chat.note_rendered_width(input.width);
+            if let Some((x, y)) = composer.cursor_pos(input) {
+                frame.set_cursor_style(composer.cursor_style(input));
+                frame.set_cursor_position((x, y));
+            }
+            rendered = area;
+        })?;
+        if autoscrolling
+            || (view.following() && active_key.is_some_and(|key| key.animation_tick.is_some()))
+        {
+            tui.frame_requester()
+                .schedule_frame_in(Duration::from_millis(60));
+        }
+        Ok(rendered)
+    }
+
+    pub(super) fn restore_native_transcript_on_exit(&mut self, tui: &mut tui::Tui) -> Result<()> {
+        if self.transcript_view.take().is_none() {
+            return Ok(());
+        }
+        let was_alternate = tui.is_alt_screen_active();
+        tui.set_docked_transcript_enabled(/*enabled*/ false);
+        tui.leave_alt_screen()?;
+        if !was_alternate {
+            tui.terminal.clear_visible_screen()?;
+            let mut area = tui.terminal.viewport_area;
+            area.y = 0;
+            area.height = 0;
+            tui.terminal.set_viewport_area(area);
+        }
+        // Append the conversation after the preserved shell, never purge the shell's scrollback.
+        let width = self
+            .chat_widget
+            .history_wrap_width(tui.terminal.size()?.width);
+        let lines = self.render_transcript_lines_for_reflow(width).lines;
+        tui.insert_history_hyperlink_lines_with_wrap_policy(lines, self.history_line_wrap_policy());
+        self.render_chat_widget_frame(tui)?;
+        Ok(())
+    }
+}
+
