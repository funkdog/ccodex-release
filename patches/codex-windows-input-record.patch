+++ b/codex-rs/tui/src/tui/windows_console_tests.rs
@@ -0,0 +1,18 @@
+use super::VirtualTerminalInput;
+use super::input_record_mode;
+use super::restored_input_mode;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn input_record_mode_preserves_non_vt_flags() {
+    let record_mode = input_record_mode(/*mode*/ 0x398);
+    assert_eq!(record_mode, 0x198);
+    assert_eq!(
+        restored_input_mode(record_mode, VirtualTerminalInput::Enabled),
+        0x398
+    );
+    assert_eq!(
+        restored_input_mode(/*mode*/ 0x198, VirtualTerminalInput::Disabled),
+        0x198
+    );
+}
